        {
          "name": "Integrations",
          "description": "P2 · #api",
          "item": [
            {
              "name": "Get the price",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jp = (json, path) => path.replace(/^\\$\\.?/, \"\").replace(/\\[(\\d+)\\]/g, \".$1\").split(\".\").filter(Boolean).reduce((o, k) => (o && typeof o === \"object\" ? o[k] : undefined), json);",
                      "let body; try { body = pm.response.json(); } catch (e) { body = pm.response.text(); }",
                      "/** Saves a value as variables (objects flattened: session.token). */",
                      "const save = (name, value) => { if (value && typeof value === \"object\") { pm.collectionVariables.set(name, JSON.stringify(value)); Object.entries(value).forEach(([k, v]) => save(`${name}.${k}`, v)); } else pm.collectionVariables.set(name, value); };",
                      "function soapFault(text) {",
                      "  const m = /<(?:[\\w.-]+:)?Body\\b[^>]*>(?:\\s|<!--[\\s\\S]*?-->)*<(?:[\\w.-]+:)?Fault\\b[\\s\\S]*?(?:<\\/(?:[\\w.-]+:)?Fault>|\\/>)/.exec(String(text || ''));",
                      "  if (!m) return null;",
                      "  const first = (re) => { const x = re.exec(m[0]); return x ? x[1].trim() : ''; };",
                      "  const code = first(/<(?:[\\w.-]+:)?faultcode\\b[^>]*>([^<]*)</) || first(/<(?:[\\w.-]+:)?Value\\b[^>]*>([^<]*)</);",
                      "  const reason = first(/<(?:[\\w.-]+:)?faultstring\\b[^>]*>([^<]*)</) || first(/<(?:[\\w.-]+:)?Text\\b[^>]*>([^<]*)</);",
                      "  return 'SOAP fault' + (code ? ' ' + code : '') + ': ' + (reason || 'no message');",
                      "}",
                      "pm.test(\"no SOAP fault\", () => pm.expect(soapFault(pm.response.text())).to.equal(null));",
                      "pm.test(\"status equals 200\", () => pm.expect(String(pm.response.code)).to.eql(String(200)));",
                      "// TODO(StepForge): check //p:Price gt (XPath is not available in Postman)",
                      "// TODO(StepForge): check count(//p:Line) gte (XPath is not available in Postman)",
                      "save(\"price\", body);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "content-type",
                    "value": "text/xml; charset=utf-8"
                  },
                  {
                    "key": "soapaction",
                    "value": "\"urn:GetPrice\""
                  }
                ],
                "url": "{{baseUrl}}/soap/prices",
                "body": {
                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Header><auth:Token xmlns:auth=\"urn:auth\">{{apiToken}}</auth:Token></soap:Header>\n  <soap:Body><m:GetPrice xmlns:m=\"urn:prices\"><m:Sku>{{ref}}</m:Sku></m:GetPrice></soap:Body>\n</soap:Envelope>"
                }
              }
            },
            {
              "name": "SOAP 1.2 envelope",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jp = (json, path) => path.replace(/^\\$\\.?/, \"\").replace(/\\[(\\d+)\\]/g, \".$1\").split(\".\").filter(Boolean).reduce((o, k) => (o && typeof o === \"object\" ? o[k] : undefined), json);",
                      "let body; try { body = pm.response.json(); } catch (e) { body = pm.response.text(); }",
                      "/** Saves a value as variables (objects flattened: session.token). */",
                      "const save = (name, value) => { if (value && typeof value === \"object\") { pm.collectionVariables.set(name, JSON.stringify(value)); Object.entries(value).forEach(([k, v]) => save(`${name}.${k}`, v)); } else pm.collectionVariables.set(name, value); };",
                      "// TODO(StepForge): check xpath://*[local-name()=\"Pong\"] exists (XPath is not available in Postman)"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "content-type",
                    "value": "application/soap+xml; charset=utf-8; action=\"urn:Ping\""
                  }
                ],
                "url": "https://soap.example.test/ws",
                "body": {
                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\"?>\n<env:Envelope xmlns:env=\"http://www.w3.org/2003/05/soap-envelope\"><env:Body><Ping/></env:Body></env:Envelope>"
                }
              }
            }
          ]
        }
      ]
    }
  ],
