            {
              "name": "OAuth2 client credentials",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jp = (json, path) => path.replace(/^\\$\\.?/, \"\").replace(/\\[(\\d+)\\]/g, \".$1\").split(\".\").filter(Boolean).reduce((o, k) => (o && typeof o === \"object\" ? o[k] : undefined), json);",
                      "let body; try { body = pm.response.json(); } catch (e) { body = pm.response.text(); }",
                      "/** Saves a value as variables (objects flattened: session.token). */",
                      "const save = (name, value) => { if (value && typeof value === \"object\") { pm.collectionVariables.set(name, JSON.stringify(value)); Object.entries(value).forEach(([k, v]) => save(`${name}.${k}`, v)); } else pm.collectionVariables.set(name, value); };",
                      "pm.test(\"OAuth2 token\", () => pm.expect(pm.variables.get(\"oauth2Error\"), pm.variables.get(\"oauth2Error\")).to.be.undefined);",
                      "pm.test(\"status equals 200\", () => pm.expect(String(pm.response.code)).to.eql(String(200)));"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const o = { tokenUrl: pm.variables.replaceIn(\"https://id.test/token\"), clientId: pm.variables.replaceIn(\"shop-tests\"), clientSecret: pm.variables.replaceIn(\"{{apiToken}}\"), scope: pm.variables.replaceIn(\"orders:read\") };\nconst key = 'oauth2:' + o.tokenUrl + '|' + o.clientId + '|' + o.scope;\nconst kept = JSON.parse(pm.collectionVariables.get(key) || 'null');\nif (kept && kept.expires > Date.now()) pm.variables.set('oauth2Token', kept.token);\nelse\n  pm.sendRequest(\n    {\n      url: o.tokenUrl,\n      method: 'POST',\n      header: {\n        Authorization: 'Basic ' + CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(o.clientId + ':' + o.clientSecret)),\n        'Content-Type': 'application/x-www-form-urlencoded',\n      },\n      body: { mode: 'urlencoded', urlencoded: [{ key: 'grant_type', value: 'client_credentials' }].concat(o.scope ? [{ key: 'scope', value: o.scope }] : []) },\n    },\n    (err, res) => {\n      let json = {};\n      try { json = res.json(); } catch (e) { /* not JSON */ }\n      if (err || res.code < 200 || res.code >= 300 || !json.access_token) pm.variables.set('oauth2Error', 'OAuth2 token request failed with ' + (err ? err.message : res.code));\n      else {\n        pm.variables.set('oauth2Token', json.access_token);\n        pm.collectionVariables.set(key, JSON.stringify({ token: json.access_token, expires: Date.now() + Math.max(30, (json.expires_in || 300) - 30) * 1000 }));\n      }\n    },\n  );"
                    ]
                  }
                }
