  "item": [
    {
      "name": "API",
      "item": [
        {
          "name": "Orders API",
          "description": "P2 · #api",
          "item": [
            {
              "name": "Get a token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jp = (json, path) => path.replace(/^\\$\\.?/, \"\").replace(/\\[(\\d+)\\]/g, \".$1\").split(\".\").filter(Boolean).reduce((o, k) => (o && typeof o === \"object\" ? o[k] : undefined), json);",
                      "let body; try { body = pm.response.json(); } catch (e) { body = pm.response.text(); }",
                      "/** Saves a value as variables (objects flattened: session.token). */",
                      "const save = (name, value) => { if (value && typeof value === \"object\") { pm.collectionVariables.set(name, JSON.stringify(value)); Object.entries(value).forEach(([k, v]) => save(`${name}.${k}`, v)); } else pm.collectionVariables.set(name, value); };",
                      "pm.test(\"status equals 200\", () => pm.expect(String(pm.response.code)).to.eql(String(200)));",
                      "save(\"token\", body);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/oauth/token",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "key": "client",
                      "value": "shop"
                    },
                    {
                      "key": "scope",
                      "value": "orders"
                    }
                  ]
                }
              }
            },
            {
              "name": "Create an order",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jp = (json, path) => path.replace(/^\\$\\.?/, \"\").replace(/\\[(\\d+)\\]/g, \".$1\").split(\".\").filter(Boolean).reduce((o, k) => (o && typeof o === \"object\" ? o[k] : undefined), json);",
                      "let body; try { body = pm.response.json(); } catch (e) { body = pm.response.text(); }",
                      "/** Saves a value as variables (objects flattened: session.token). */",
                      "const save = (name, value) => { if (value && typeof value === \"object\") { pm.collectionVariables.set(name, JSON.stringify(value)); Object.entries(value).forEach(([k, v]) => save(`${name}.${k}`, v)); } else pm.collectionVariables.set(name, value); };",
                      "pm.test(\"status equals 201\", () => pm.expect(String(pm.response.code)).to.eql(String(201)));",
                      "pm.test(\"$.id exists\", () => pm.expect(jp(body, \"$.id\")).to.exist);",
                      "pm.test(\"$.items[*].sku contains \\\"A-1\\\"\", () => pm.expect(jp(body, \"$.items[*].sku\")).to.include(\"A-1\"));",
                      "pm.test(\"header:content-type contains \\\"json\\\"\", () => pm.expect(pm.response.headers.get(\"content-type\")).to.include(\"json\"));",
                      "pm.test(\"time lte 800\", () => pm.expect(Number(pm.response.responseTime)).to.be.at.most(Number(800)));",
                      "pm.test(\"$.total inRange [0,1000]\", () => pm.expect.fail(\"operator inRange is not exported\"));",
                      "save(\"order\", body);",
                      "save(\"location\", pm.response.headers.get(\"location\"));",
                      "save(\"code\", pm.response.code);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Request-Id",
                    "value": "{{$guid}}"
                  },
                  {
                    "key": "X-Region",
                    "value": "{{region}}"
                  }
                ],
                "url": "{{baseUrl}}/api/{{api-version}}/orders?dryRun=false",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"A-1\",\n      \"qty\": 2\n    }\n  ],\n  \"note\": \"it's \\\"quoted\\\" & {braced}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"at\": \"{{$timestamp}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{apiToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
