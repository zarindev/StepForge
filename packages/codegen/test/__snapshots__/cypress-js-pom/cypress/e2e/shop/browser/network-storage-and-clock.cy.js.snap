// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Shop › Browser › Network, storage and clock (P2, #browser)
import { check, pick, field } from '../../../support/helpers.js';
import { env } from '../../../support/config.js';
import {
  watchNetwork,
  waitForResponse,
  mockRoute,
  storage,
  download,
  fixClock,
  pageCondition,
  byTestId,
  byRole,
  byCss,
} from '../../../support/web.js';
import { productsPage } from '../../../pages/ProductsPage.js';

// Tags: @browser @p2
describe('Shop › Browser › Network, storage and clock', () => {
  it('Network, storage and clock', () => {
    const vars = {};
    const last = {};
    watchNetwork();
    // Set the page clock to 2026-03-01T09:00:00Z (running)
    // TODO(StepForge): ui.setClock (install) — cy.clock() stops time, so this is not the same in Cypress
    // Answer requests to **/api/stock* with 200
    mockRoute({
      url: '**/api/stock*',
      method: 'GET',
      action: 'fulfill',
      status: 200,
      body: {
        inStock: true,
        sku: `${env.region}-1`,
      },
    });
    // Make requests to /api/ads fail
    mockRoute({ url: '/api/ads', action: 'abort' });
    // Slow down requests to /api/slow by 500 ms
    mockRoute({ url: '/api/slow', action: 'delay', delayMs: 500, times: 2 });
    // Answer requests to /api/banner with 503
    mockRoute({
      url: '/api/banner',
      action: 'fulfill',
      status: 503,
      body: 'down',
      contentType: 'text/plain',
    });
    // Open /products
    cy.visit('/products');
    // Wait for the GET response from /api/products (save as products)
    cy.then(() => {
      waitForResponse({ url: '/api/products', method: 'GET', status: 200, timeoutMs: 15000 }).then((res) => {
        check(pick(res, '$.items[0].sku'), 'exists', null, '$.items[0].sku exists');
        check(pick(res, 'header:content-type'), 'contains', 'json', 'header:content-type contains');
        check(pick(res, 'url'), 'contains', '/api/products', 'url contains');
        vars.products = res.body;
      });
    });
    // Stop faking **/api/stock*
    mockRoute({ url: '**/api/stock*', action: 'remove' });
    // Tap the "Menu" button
    // Cypress has no touch screen: a tap fires the touch events, then the click they lead to
    productsPage.menuButton().trigger('touchstart').trigger('touchend').click();
    // Download the file from the "Export CSV" link (save as csv)
    cy.then(() => {
      download(() => productsPage.exportCsvLink()).then((file) => {
        check(file.fileName, 'matches', '\\.csv$', 'fileName matches');
        check(file.size, 'gt', 0, 'size gt');
        check(file.content, 'contains', 'sku', 'content contains');
        vars.csv = file;
      });
    });
    // Set the cookie "consent" to "yes"
    storage({ kind: 'cookie', action: 'set', name: 'consent', value: 'yes' });
    // Read the cookie "consent"
    storage({ kind: 'cookie', action: 'get', name: 'consent' }).then((stored) => {
      check(stored.value, 'equals', 'yes', 'value equals');
    });
    // Remove the cookie "consent"
    storage({ kind: 'cookie', action: 'remove', name: 'consent' });
    // Set the local storage "cart" to "[object Object]"
    storage({ kind: 'local', action: 'set', name: 'cart', value: '{"items":2}' });
    // Read the local storage "cart" (save as cart)
    cy.then(() => {
      storage({ kind: 'local', action: 'get', name: 'cart' }).then((stored) => {
        check(stored.exists, 'equals', true, 'exists equals');
        vars.cart = stored.value;
      });
    });
    // Clear session storage
    storage({ kind: 'session', action: 'clear' });
    // Clear all cookies
    storage({ kind: 'cookie', action: 'clear' });
    // TODO(StepForge): ui.setOffline: going offline is not exported to Cypress: it has no offline mode of its own (only through the Chrome DevTools protocol, which its own runner uses too); test the offline page by hand
    // Check that "You are offline" is visible
    productsPage.youAreOfflineText().should('be.visible');
    // TODO(StepForge): ui.setOffline: going offline is not exported to Cypress: it has no offline mode of its own (only through the Chrome DevTools protocol, which its own runner uses too); test the offline page by hand
    // Move the clock forward 300000 ms
    // TODO(StepForge): ui.setClock (fastForward) — cy.clock() stops time, so this is not the same in Cypress
    // Set the page clock to 1772355600000
    fixClock(new Date(1772355600000));
    // If the "Accept cookies" button is visible
    cy.then(() => pageCondition(byRole('button', 'Accept cookies'), 'visible', undefined, 1000)).then(
      (holds) => {
        if (holds) {
          // Click the "Accept cookies" button
          productsPage.acceptCookiesButton().click();
        } else {
          // Note: No cookie banner
          cy.log('No cookie banner');
        }
      },
    );
    // Load every page
    cy.then(() => {
      const pass1 = (pass) => {
        if (pass >= 20) throw new Error('Stopped after the limit of 20 pass(es); the condition still held');
        vars.index = pass;
        pageCondition(byRole('button', 'Load more'), 'enabled').then((holds) => {
          if (!holds) return;
          // Click the "Load more" button
          productsPage.loadMoreButton().click();
          cy.then(() => pass1(pass + 1));
        });
      };
      pass1(0);
    });
    // If there are 12 × the element ".product-card"
    cy.then(() => pageCondition(byCss('.product-card'), 'count', 12)).then((holds) => {
      if (holds) {
        // Note: A full page
        cy.log('A full page');
      }
    });
    // If the element "status" contains "{{vars.csv.fileName}}"
    cy.then(() =>
      pageCondition(byTestId('status'), 'textContains', String(field(vars, 'csv.fileName'))),
    ).then((holds) => {
      if (holds) {
        // Note: Status names the file
        cy.log('Status names the file');
      }
    });
    // TODO(StepForge): ui.networkSummary: the network summary is not exported to Cypress: it does not see the size of each response or the requests the page lost; check the traffic in StepForge
  });
});
