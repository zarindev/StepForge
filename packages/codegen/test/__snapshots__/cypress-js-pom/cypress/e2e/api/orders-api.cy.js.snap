// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: API › Orders API (P2, #api)
import { check, compare, pick, fake, field, random, runId } from '../../support/helpers.js';
import { env, secret } from '../../support/config.js';
import { toResult, basicAuth, oauth2Token } from '../../support/api.js';
import { pageCondition, byRole, byText } from '../../support/web.js';
import { expectSchema } from '../../support/schema.js';

// Tags: @api @p2
describe('API › Orders API', () => {
  it('Orders API', () => {
    const data = {};
    const vars = {};
    const last = {};
    // Get a token
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: '/oauth/token',
        body: {
          client: 'shop',
          scope: 'orders',
        },
        form: true,
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        expect(res.status, 'status').to.eq(200);
        vars.token = res.body;
        last.api = res;
      });
    });
    // Create an order
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: `/api/${env['api-version']}/orders`,
        headers: {
          'X-Request-Id': String(random.uuid()),
          'X-Region': env.region,
          Authorization: `Bearer ${secret('API_TOKEN')}`,
        },
        qs: { dryRun: false },
        body: {
          items: [
            {
              sku: 'A-1',
              qty: 2,
            },
          ],
          note: 'it\'s "quoted" & {braced}',
          email: random.email(),
          at: random.timestamp(),
        },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        expect(res.status, 'status').to.eq(201);
        check(pick(res, '$.id'), 'exists', null, '$.id exists');
        check(pick(res, '$.items[*].sku'), 'contains', 'A-1', '$.items[*].sku contains');
        check(pick(res, 'header:content-type'), 'contains', 'json', 'header:content-type contains');
        check(pick(res, 'time'), 'lte', 800, 'time lte');
        check(pick(res, '$.total'), 'inRange', [0, 1000], '$.total inRange');
        expectSchema(
          res.body,
          {
            type: 'object',
          },
          '$ matches the JSON schema',
        );
        vars.order = res.body;
        last.api = res;
      });
    });
    // Read the location header of the response (save as location)
    cy.then(() => {
      vars.location = pick(last.api, 'header:location');
    });
    // Read the response status (save as code)
    cy.then(() => {
      vars.code = pick(last.api, 'status');
    });
    // Basic auth
    cy.then(() => {
      cy.request({
        method: 'GET',
        url: '/admin',
        headers: { Authorization: basicAuth('admin', secret('ADMIN_PASSWORD')) },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // API key in query
    cy.then(() => {
      cy.request({
        method: 'GET',
        url: '/reports',
        qs: { key: secret('API_TOKEN') },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // API key header
    cy.then(() => {
      cy.request({
        method: 'DELETE',
        url: `/api/orders/${field(vars, 'order.id')}`,
        headers: { 'x-api-key': secret('API_TOKEN') },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // Cookie
    cy.then(() => {
      cy.request({
        method: 'GET',
        url: '/me',
        headers: { Cookie: `sid=${'abc'}` },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // OAuth2 client credentials
    cy.then(() => {
      oauth2Token({
        tokenUrl: 'https://id.test/token',
        clientId: 'shop-tests',
        clientSecret: secret('API_TOKEN'),
        scope: 'orders:read',
      }).then((token) => {
        cy.request({
          method: 'GET',
          url: '/x',
          headers: { Authorization: `Bearer ${token}` },
          failOnStatusCode: false,
        }).then((response) => {
          const res = toResult(response);
          expect(res.status, 'status').to.eq(200);
          last.api = res;
        });
      });
    });
    // Upload
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: '/files',
        body: {
          name: 'a.txt',
        },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // Raw text
    cy.then(() => {
      cy.request({
        method: 'PUT',
        url: 'https://other.test/raw',
        body: `plain ${data.missing} text`,
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        last.api = res;
      });
    });
    // GraphQL
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: '/graphql',
        body: {
          query: 'query { me { id } }',
          variables: {
            first: 1,
          },
        },
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        check(pick(res, '$.data.me.id'), 'isNotEmpty', null, '$.data.me.id isNotEmpty');
        check(pick(res, '$.errors'), 'notExists', null, '$.errors notExists');
        last.api = res;
      });
    });
    // If {{vars.code}} equals "201"
    cy.then(() => {
      if (compare(vars.code, 'equals', 201)) {
        // Note: Created {{vars.order.id}}
        cy.then(() => {
          cy.log(`Created ${field(vars, 'order.id')}`);
        });
      } else {
        // Note: Not created
        cy.log('Not created');
      }
    });
    // Repeat 3 times
    cy.then(() => {
      for (let index = 0; index < 3; index++) {
        cy.then(() => {
          vars.index = index;
        });
        // Send GET /ping?i={{vars.index}}
        cy.then(() => {
          cy.request({
            method: 'GET',
            url: `/ping?i=${vars.index}`,
            failOnStatusCode: false,
          }).then((response) => {
            const res = toResult(response);
            last.api = res;
          });
        });
      }
    });
    // Repeat for each line in {{vars.order.items}}
    cy.then(() => {
      field(vars, 'order.items').forEach((item, index) => {
        cy.then(() => {
          vars.line = item;
          vars.index = index;
        });
        // Note: {{vars.line.sku}}
        cy.then(() => {
          cy.log(String(field(vars, 'line.sku')));
        });
      });
    });
    // Repeat while the "Load more" button is visible
    cy.then(() => {
      const pass1 = (pass) => {
        if (pass >= 100) throw new Error('Stopped after the limit of 100 pass(es); the condition still held');
        vars.index = pass;
        pageCondition(byRole('button', 'Load more'), 'visible').then((holds) => {
          if (!holds) return;
          // Note: more
          cy.log('more');
          cy.then(() => pass1(pass + 1));
        });
      };
      pass1(0);
    });
    // If "Out of stock" is on the page
    cy.then(() => pageCondition(byText('Out of stock'), 'present')).then((holds) => {
      if (holds) {
        // Note: oos
        cy.log('oos');
      }
    });
    // Poll until three
    cy.then(() => {
      const pass2 = (pass) => {
        if (pass >= 5) throw new Error('Stopped after the limit of 5 pass(es); the condition still held');
        vars.index = pass;
        if (!compare(vars.index, 'lt', 3)) return;
        // Send GET /poll
        cy.then(() => {
          cy.request({
            method: 'GET',
            url: '/poll',
            failOnStatusCode: false,
          }).then((response) => {
            const res = toResult(response);
            last.api = res;
          });
        });
        cy.then(() => pass2(pass + 1));
      };
      pass2(0);
    });
    // Remember "[object Object]" as payload
    cy.then(() => {
      vars.payload = {
        a: [1, true, null],
        b: runId,
      };
    });
    // Generate a random pattern (save as ref)
    cy.then(() => {
      vars.ref = fake('pattern', { pattern: 'ORD-####' });
    });
    // Generate a random date (save as due)
    cy.then(() => {
      vars.due = fake('date', { direction: 'future', days: 10 });
    });
    // Wait 250 ms
    cy.wait(250);
    // Run a script (save as double)
    cy.then(() => {
      vars.double = ((vars, data) => {
        return vars.total * 2;
      })(vars, data);
    });
  });
});
