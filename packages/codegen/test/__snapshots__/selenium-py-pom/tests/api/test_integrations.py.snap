# Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
# Scenario: API › Integrations (P2, #api)
import time

import pytest

from support.config import env, secret
from support.helpers import check, text, RUN_ID
from support import api
from support import kafka
from support.ftp import ftp
from support.xml import xpath_value, expect_no_fault


@pytest.mark.api
@pytest.mark.p2
def test_integrations(http):
    """Integrations"""
    test_start = time.time()
    vars = {}
    # Get the price
    res1 = api.call(
        http, "POST", "/soap/prices",
        headers={"content-type": "text/xml; charset=utf-8", "soapaction": "\"urn:GetPrice\""},
        data=f"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Header><auth:Token xmlns:auth=\"urn:auth\">{text(secret('API_TOKEN'))}</auth:Token></soap:Header>\n  <soap:Body><m:GetPrice xmlns:m=\"urn:prices\"><m:Sku>{text(vars.get('ref'))}</m:Sku></m:GetPrice></soap:Body>\n</soap:Envelope>",
    )
    expect_no_fault(res1["text"])
    assert res1["status"] == 200, "status"
    check(xpath_value(res1["text"], "//p:Price", {"p": "urn:prices"}), "gt", 0, "//p:Price gt")
    check(xpath_value(res1["text"], "count(//p:Line)", {"p": "urn:prices"}), "gte", 1, "count(//p:Line) gte")
    vars["price"] = res1["body"]
    # SOAP 1.2 envelope
    res2 = api.call(
        http, "POST", "https://soap.example.test/ws",
        headers={"content-type": "application/soap+xml; charset=utf-8; action=\"urn:Ping\""},
        data="<?xml version=\"1.0\"?>\n<env:Envelope xmlns:env=\"http://www.w3.org/2003/05/soap-envelope\"><env:Body><Ping/></env:Body></env:Envelope>",
    )
    check(xpath_value(res2["text"], "xpath://*[local-name()=\"Pong\"]"), "exists", None, "xpath://*[local-name()=\"Pong\"] exists")
    # Publish an order event
    message1 = kafka.produce({
        "brokers": "localhost:9092",
        "topic": "orders",
        "key": vars.get("ref"),
        "value": {
            "id": vars.get("ref"),
            "total": 10,
        },
        "headers": {
            "source": "tests",
        },
        "sasl": {
            "mechanism": "plain",
            "username": "shop",
            "password": secret("API_TOKEN"),
        },
    }, 15000)
    check(kafka.pick_message(message1, "offset"), "exists", None, "offset exists")
    # Wait for the invoice event
    message2 = kafka.consume({
        "brokers": "localhost:9092",
        "topic": "invoices",
        "path": "$.orderId",
        "equals": vars.get("ref"),
        "timeoutMs": 20000,
    }, test_start, 20000)
    check(kafka.pick_message(message2, "$.status"), "equals", "issued", "$.status equals")
    check(kafka.pick_message(message2, "header:source"), "equals", "billing", "header:source equals")
    vars["invoice"] = message2
    # Upload the price list
    ftp({
        "protocol": "sftp",
        "host": "files.shop.test",
        "port": 22,
        "username": "shop",
        "password": secret("ADMIN_PASSWORD"),
        "action": "upload",
        "remotePath": f"/in/prices-{text(RUN_ID)}.csv",
        "content": "sku,price\nA-1,10\n",
    })
    # Read the report
    ftp2 = ftp({
        "protocol": "ftp",
        "host": "files.shop.test",
        "username": "shop",
        "password": secret("ADMIN_PASSWORD"),
        "action": "download",
        "remotePath": "/out/report.csv",
    })
    check(ftp2["content"], "contains", "A-1", "content contains")
    vars["report"] = ftp2
    # List the inbox
    ftp3 = ftp({
        "protocol": "ftps",
        "host": "files.shop.test",
        "username": "shop",
        "password": secret("ADMIN_PASSWORD"),
        "action": "list",
        "remotePath": "/in",
    })
    check(ftp3["count"], "gte", 1, "count gte")
