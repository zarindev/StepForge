# Scenario: Shop › Browser › Network, storage and clock (P2, #browser)

import pytest

from support.helpers import check, field, text, file_text
from pages.products_page import ProductsPage


@pytest.mark.browser
@pytest.mark.p2
def test_network_storage_and_clock(browser):
    """Network, storage and clock"""
    vars = {}
    # TODO(StepForge): ui.setClock: Selenium has no page clock without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.mockRoute: Selenium has no way to fake responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.mockRoute: Selenium has no way to fake responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.mockRoute: Selenium has no way to fake responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.mockRoute: Selenium has no way to fake responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # Open /products
    browser.goto("/products")
    # TODO(StepForge): ui.waitForResponse: Selenium has no access to the page’s responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.mockRoute: Selenium has no way to fake responses without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # Tap the "Menu" button
    browser.tap(ProductsPage.MENU_BUTTON)
    # Download the file from the "Export CSV" link (save as csv)
    file1 = browser.download(ProductsPage.EXPORT_CSV_LINK)
    check(file1["fileName"], "matches", "\\.csv$", "fileName matches")
    check(file1["size"], "gt", 0, "size gt")
    check(file_text(file1), "contains", "sku", "content contains")
    vars["csv"] = file1
    # Set the cookie "consent" to "yes"
    browser.storage(kind="cookie", action="set", name="consent", value="yes")
    # Read the cookie "consent"
    stored1 = browser.storage(kind="cookie", action="get", name="consent")
    check(stored1["value"], "equals", "yes", "value equals")
    # Remove the cookie "consent"
    browser.storage(kind="cookie", action="remove", name="consent")
    # Set the local storage "cart" to "[object Object]"
    browser.storage(kind="local", action="set", name="cart", value="{\"items\":2}")
    # Read the local storage "cart" (save as cart)
    stored2 = browser.storage(kind="local", action="get", name="cart")
    check(stored2["exists"], "equals", True, "exists equals")
    vars["cart"] = stored2["value"]
    # Clear session storage
    browser.storage(kind="session", action="clear")
    # Clear all cookies
    browser.storage(kind="cookie", action="clear")
    # Go offline
    browser.set_offline(True)
    # Check that "You are offline" is visible
    browser.expect("visible", ProductsPage.YOU_ARE_OFFLINE_TEXT)
    # Go back online
    browser.set_offline(False)
    # TODO(StepForge): ui.setClock: Selenium has no page clock without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # TODO(StepForge): ui.setClock: Selenium has no page clock without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
    # If the "Accept cookies" button is visible
    if browser.page_condition(("role", "button", "Accept cookies"), "visible", None, 1000):
        # Click the "Accept cookies" button
        browser.click(ProductsPage.ACCEPT_COOKIES_BUTTON)
    else:
        # Note: No cookie banner
        print("No cookie banner")
    # Load every page
    for index in range(20):
        vars["index"] = index
        if not browser.page_condition(("role", "button", "Load more"), "enabled"):
            break
        # Click the "Load more" button
        browser.click(ProductsPage.LOAD_MORE_BUTTON)
    else:
        raise AssertionError("Stopped after the limit of 20 pass(es); the condition still held")
    # If there are 12 × the element ".product-card"
    if browser.page_condition(("css", ".product-card"), "count", 12):
        # Note: A full page
        print("A full page")
    # If the element "status" contains "{{vars.csv.fileName}}"
    if browser.page_condition(("testId", "status"), "textContains", text(field(vars, "csv.fileName"))):
        # Note: Status names the file
        print("Status names the file")
    # TODO(StepForge): ui.networkSummary: Selenium has no record of the page’s traffic without Chrome DevTools; not exported to Selenium + pytest (write it with the browser’s DevTools protocol)
