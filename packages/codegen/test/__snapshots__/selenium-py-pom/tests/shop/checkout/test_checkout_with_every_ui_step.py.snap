# Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
# Scenario: Shop › Checkout › Checkout with every UI step (P1, #smoke #checkout flow)
# Covers the whole UI catalogue.
# Preconditions: A product is in stock.

import pytest

from support.config import env, secret
from support.helpers import check, capture, text
from pages.login_page import LoginPage
from pages.products_page import ProductsPage


@pytest.mark.smoke
@pytest.mark.checkout_flow
@pytest.mark.p1
@pytest.mark.parametrize(
    "data",
    [{"user": "ana@shop.test", "qty": 2}, {"user": "ben@shop.test", "qty": 1}],
    ids=["TC-CHE-001 Card payment", "TC-CHE-002 Voucher \"SAVE10\""],
)
def test_checkout_with_every_ui_step(browser, data):
    """Checkout with every UI step"""
    vars = {}
    # Block: Sign in as admin
    # Open /login
    browser.goto("/login")
    # Type "{{data.user}}" into the "Email" field
    browser.fill(LoginPage.EMAIL_FIELD, text(data.get("user")))
    # Type "{{secret.adminPassword}}" into the field with placeholder "Password"
    browser.fill(LoginPage.PASSWORD_FIELD, secret("ADMIN_PASSWORD"))
    # Click the "Sign in" button
    browser.click(LoginPage.SIGN_IN_BUTTON)
    # Scenario: Open the cart
    # Open /cart
    browser.goto("/cart")
    # Open {{env.baseUrl}}/products?region={{env.region}}
    browser.goto(f"{text(env['base_url'])}/products?region={text(env['region'])}")
    browser.expect("titleContains", expected="Products")
    # Click the element "product-1"
    browser.click(ProductsPage.PRODUCT1)
    browser.expect("urlMatches", expected="/products/\\d+")
    # Double-click "Zoom image"
    browser.click(ProductsPage.ZOOM_IMAGE_TEXT, double=True)
    # Right-click the element ".gallery img"
    browser.click(ProductsPage.ELEMENT3, right=True)
    # Hover over the "Details" link
    browser.hover(ProductsPage.DETAILS_LINK)
    # Type "blue {{data.qty}}" into the "Search" field
    browser.type(ProductsPage.SEARCH_FIELD, f"blue {text(data.get('qty'))}")
    # Clear the "Search" field
    browser.clear(ProductsPage.SEARCH_FIELD)
    # Type "{{data.qty}}" into the element "qty"
    browser.fill(ProductsPage.QTY, text(data.get("qty")))
    browser.expect("value", ProductsPage.QTY, expected=text(data.get("qty")))
    # Press Enter in the element "qty"
    browser.press(ProductsPage.QTY, "Enter")
    # Press Control+A
    browser.press(None, "Control+A")
    # Select "express" in the "Shipping" field
    browser.select(ProductsPage.SHIPPING_FIELD, value="express")
    # Select "Gift wrap" in the "Extras" field
    browser.select(ProductsPage.EXTRAS_FIELD, label="Gift wrap")
    # Select "2" in the "Country" field
    browser.select(ProductsPage.COUNTRY_FIELD, index=2)
    # Tick the "I agree" checkbox
    browser.set_checked(ProductsPage.I_AGREE_CHECKBOX, True)
    # Untick the "Newsletter" checkbox
    browser.set_checked(ProductsPage.NEWSLETTER_CHECKBOX, False)
    # Upload fixtures/invoice.pdf to the "Attachment" field
    browser.upload(ProductsPage.ATTACHMENT_FIELD, "fixtures/invoice.pdf")
    # Drag the element "item-a" onto the element "basket"
    browser.drag(ProductsPage.ITEM_A, ProductsPage.BASKET)
    # Scroll down the page
    browser.scroll(0, 800)
    # Scroll to the element "footer"
    browser.scroll_into_view(ProductsPage.FOOTER)
    # Accept the next browser dialog
    browser.handle_next_dialog(accept=True, prompt_text="yes")
    # Click the element "//button[@id='remove']"
    browser.click(ProductsPage.ELEMENT16)
    # Dismiss the next browser dialog
    browser.handle_next_dialog(accept=False)
    # Switch into the frame "iframe#payment"
    browser.frame("iframe#payment")
    # Type "4242 4242 4242 4242" into the field with placeholder "Card number"
    browser.fill(("placeholder", "Card number"), "4242 4242 4242 4242")
    # Return to the main page
    browser.frame()
    # Click the "Terms" link
    browser.click(ProductsPage.TERMS_LINK)
    # Switch to the new tab
    browser.switch_tab()
    # Wait for the page to load
    browser.wait_for_load()
    # Close the current tab
    browser.close_tab()
    # Switch to the new tab
    browser.switch_tab(index=0)
    # Wait until the element "spinner" is hidden
    browser.wait_for(("testId", "spinner"), "hidden")
    # Wait for the URL **/checkout/*
    browser.wait_for_url("**/checkout/*")
    # Order summary
    browser.screenshot("orderSummary")
    # Total box
    browser.screenshot("totalBox", ("testId", "total"))
    # Read the text of the element "total" (save as total)
    vars["total"] = capture(browser.read("text", ("testId", "total")), "([\\d.]+)")
    # Read the attribute of the "Invoice" link (save as invoiceUrl)
    vars["invoiceUrl"] = browser.read("attribute", ("role", "link", "Invoice"), attribute="href")
    # Read the count of the element ".line-item" (save as lines)
    vars["lines"] = browser.read("count", ("css", ".line-item"))
    # Read the url of the page (save as here)
    vars["here"] = browser.read("url")
    # Check that the "Order confirmed" heading is visible
    browser.expect("visible", ("role", "heading", "Order confirmed"))
    # Check that the element "error" is hidden
    browser.expect("hidden", ("testId", "error"))
    # Check that the element "greeting" reads "Thank you, {{data.user}}!"
    browser.expect("text", ("testId", "greeting"), expected=f"Thank you, {text(data.get('user'))}!")
    # Check that the element "total" contains "{{vars.total}}"
    browser.expect("textContains", ("testId", "total"), expected=text(vars.get("total")))
    # Check that the element "order-id" matches /^ORD-\d{6}$/
    browser.expect("textMatches", ("testId", "order-id"), expected="^ORD-\\d{6}$")
    # Check that the "Shipping" field has the value "express"
    browser.expect("value", ("label", "Shipping"), expected="express")
    # Check that there are 2 × the element ".line-item"
    browser.expect("count", ("css", ".line-item"), expected=2)
    # Check an attribute of the element "cart" equals "false"
    browser.expect("attribute", ("testId", "cart"), expected="false", attribute="aria-busy")
    # Check that the "Pay" button is enabled
    browser.expect("enabled", ("role", "button", "Pay"))
    # Check that the "Undo" button is disabled
    browser.expect("disabled", ("role", "button", "Undo"))
    # Check that the "I agree" checkbox is checked
    browser.expect("checked", ("role", "checkbox", "I agree"))
    # Check that the "Newsletter" checkbox is not checked
    browser.expect("unchecked", ("role", "checkbox", "Newsletter"))
    # Check that the URL is "/orders/done"
    browser.expect("url", expected="/orders/done")
    # Check that the URL contains "done"
    browser.expect("urlContains", expected="done")
    # Check that the page title is "Order confirmed"
    browser.expect("title", expected="Order confirmed")
    # Check that the page title contains "confirmed"
    browser.expect("titleContains", expected="confirmed")
    # Click the element "receipt"
    browser.click(("testId", "receipt"))
    vars["actual1"] = browser.read("text", ("testId", "receipt"))
    check(vars.get("actual1"), "notContains", "Error", "text notContains")
    # TODO(StepForge): ui.visualCheckpoint: visual checkpoints are not exported; add a screenshot comparison in the target framework
    # Disabled in StepForge: Click the element "legacy"
