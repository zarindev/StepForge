@Tag("api")
@Tag("p2")
@DisplayName("API › Orders API")
class OrdersApiTest extends ApiTest {
  @Test
  @DisplayName("Orders API")
  void ordersApi() throws Exception {
    Map<String, Object> data = new HashMap<>();
    Map<String, Object> vars = new HashMap<>();
    // Get a token
    Api.Result res1 = Api.result(
        given()
            .filter(cookies)
            .contentType(ContentType.URLENC)
            .formParams(J.map("client", "shop", "scope", "orders"))
            .when()
            .request("POST", "/oauth/token")
    );
    assertEquals(200, res1.status(), "status");
    vars.put("token", res1.body());
    // TODO(StepForge): api.request: the JSON Schema check on "$" is not exported
    Api.Result res2 = Api.result(
        given()
            .filter(cookies)
            .header("X-Request-Id", text(Fake.random("uuid")))
            .header("X-Region", Config.env("region"))
            .queryParam("dryRun", false)
            .header("Authorization", "Bearer " + Config.secret("API_TOKEN"))
            .contentType(ContentType.JSON)
            .body(J.map("items", J.list(J.map("sku", "A-1", "qty", 2)), "note", "it's \"quoted\" & {braced}", "email", Fake.random("email"), "at", Fake.random("timestamp")))
            .when()
            .request("POST", "/api/" + Config.env("api-version") + "/orders")
    );
    assertEquals(201, res2.status(), "status");
    check(pick(res2, "$.id"), "exists", null, "$.id exists");
    check(pick(res2, "$.items[*].sku"), "contains", "A-1", "$.items[*].sku contains");
    check(pick(res2, "header:content-type"), "contains", "json", "header:content-type contains");
    check(pick(res2, "time"), "lte", 800, "time lte");
    check(pick(res2, "$.total"), "inRange", J.list(0, 1000), "$.total inRange");
    vars.put("order", res2.body());
    // Read the location header of the response (save as location)
    vars.put("location", pick(res2, "header:location"));
    // Read the response status (save as code)
    vars.put("code", pick(res2, "status"));
    // Basic auth
    Api.Result res3 = Api.result(
        given()
            .filter(cookies)
            .auth().preemptive().basic("admin", Config.secret("ADMIN_PASSWORD"))
            .when()
            .request("GET", "/admin")
    );
    // API key in query
    Api.Result res4 = Api.result(
        given()
            .filter(cookies)
            .queryParam("key", Config.secret("API_TOKEN"))
            .when()
            .request("GET", "/reports")
    );
    // API key header
    Api.Result res5 = Api.result(
        given()
            .filter(cookies)
            .header("x-api-key", Config.secret("API_TOKEN"))
            .when()
            .request("DELETE", "/api/orders/" + text(field(vars, "order.id")))
    );
    // Cookie
    Api.Result res6 = Api.result(
        given()
            .filter(cookies)
            .cookie("sid", "abc")
            .when()
            .request("GET", "/me")
    );
    // TODO(StepForge): api.request: auth type "oauth2" is not exported; set the header yourself
    Api.Result res7 = Api.result(
        given()
            .filter(cookies)
            .when()
            .request("GET", "/x")
    );
    // Upload
    Api.Result res8 = Api.result(
        given()
            .filter(cookies)
            .contentType(ContentType.MULTIPART)
            .formParams(J.map("name", "a.txt"))
            .when()
            .request("POST", "/files")
    );
    // Raw text
    Api.Result res9 = Api.result(
        given()
            .filter(cookies)
            .body("plain " + text(data.get("missing")) + " text")
            .when()
            .request("PUT", "https://other.test/raw")
    );
    // GraphQL
    Api.Result res10 = Api.result(
        given()
            .filter(cookies)
            .queryParam("0", "q")
            .queryParam("1", "u")
            .queryParam("2", "e")
            .queryParam("3", "r")
            .queryParam("4", "y")
            .queryParam("5", " ")
            .queryParam("6", "{")
            .queryParam("7", " ")
            .queryParam("8", "m")
            .queryParam("9", "e")
            .queryParam("10", " ")
            .queryParam("11", "{")
            .queryParam("12", " ")
            .queryParam("13", "i")
            .queryParam("14", "d")
            .queryParam("15", " ")
            .queryParam("16", "}")
            .queryParam("17", " ")
            .queryParam("18", "}")
            .contentType(ContentType.JSON)
            .body(J.map("query", "query { me { id } }", "variables", J.map("first", 1)))
            .when()
            .request("POST", "/graphql")
    );
    check(pick(res10, "$.data.me.id"), "isNotEmpty", null, "$.data.me.id isNotEmpty");
    check(pick(res10, "$.errors"), "notExists", null, "$.errors notExists");
    // If {{vars.code}} equals "201"
    if (compare(vars.get("code"), "equals", 201)) {
      // Note: Created {{vars.order.id}}
      System.out.println("Created " + text(field(vars, "order.id")));
    } else {
      // Note: Not created
      System.out.println("Not created");
    }
    // Repeat 3 times
    for (int index = 0; index < 3; index++) {
      vars.put("index", index);
      // Send GET /ping?i={{vars.index}}
      Api.Result res11 = Api.result(
          given()
              .filter(cookies)
              .when()
              .request("GET", "/ping?i=" + text(vars.get("index")))
      );
    }
    // Repeat for each line in {{vars.order.items}}
    {
      int index = 0;
      for (Object item : J.items(field(vars, "order.items"))) {
        vars.put("line", item);
        vars.put("index", index++);
        // Note: {{vars.line.sku}}
        System.out.println(text(field(vars, "line.sku")));
      }
    }
    // Remember "[object Object]" as payload
    vars.put("payload", J.map("a", J.list(1, true, null), "b", Config.RUN_ID));
    // Generate a random pattern (save as ref)
    vars.put("ref", Fake.data("pattern", J.map("pattern", "ORD-####")));
    // Generate a random date (save as due)
    vars.put("due", Fake.data("date", J.map("direction", "future", "days", 10)));
    // Wait 250 ms
    Thread.sleep(250);
    // Run a script (save as double)
    // TODO(StepForge): this JavaScript step was not translated to Java:
    //   return vars.total * 2;
  }
