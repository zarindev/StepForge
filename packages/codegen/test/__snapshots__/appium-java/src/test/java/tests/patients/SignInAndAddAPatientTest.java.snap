// Scenario: Patients › Sign in and add a patient (P1, #smoke)
package tests.patients;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static io.restassured.RestAssured.given;
import static support.App.by;
import static support.Checks.compare;
import static support.Checks.text;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Stream;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;
import org.junit.jupiter.params.provider.MethodSource;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import support.Api;
import support.AppTest;
import support.Config;
import support.J;

@Tag("smoke")
@Tag("p1")
@DisplayName("Patients › Sign in and add a patient")
class SignInAndAddAPatientTest extends AppTest {
  static Stream<Arguments> testCases() {
    return Stream.of(
        Arguments.of("TC-1 Short name", J.map("name", "Ana Silva")),
        Arguments.of("TC-2 Long name", J.map("name", "Alexandra Johnson"))
    );
  }

  @ParameterizedTest(name = "{0}")
  @MethodSource("testCases")
  void signInAndAddAPatient(String testCase, Map<String, Object> data) throws Exception {
    Map<String, Object> vars = new HashMap<>();
    // Type "nurse@careclinic.test" into the field with placeholder "Email"
    app.fill(List.of(by("xpath", "//*[@hint='Email']")), "nurse@careclinic.test");
    // Type "{{secret.nursePassword}}" into the element "password"
    app.fill(List.of(by("id", "password"), by("accessibility id", "password")), Config.secret("NURSE_PASSWORD"));
    // Click the "Sign in" button
    app.click(List.of(by("xpath", "//*[@class='android.widget.Button' or @class='android.widget.ImageButton'][@text='Sign in' or @content-desc='Sign in' or @hint='Sign in']")));
    // Check that the element "patient_count" reads "No patients yet"
    app.expect("text", List.of(by("id", "patient_count"), by("accessibility id", "patient_count")), "No patients yet", null);
    // Type "{{data.name}}" into the "Patient name" field
    app.fill(List.of(by("accessibility id", "Patient name"), by("xpath", "//*[@hint='Patient name']")), text(data.get("name")));
    // Tap "Add patient"
    app.click(List.of(by("-android uiautomator", "new UiSelector().text(\"Add patient\")"), by("-android uiautomator", "new UiSelector().textContains(\"Add patient\")"), by("-android uiautomator", "new UiSelector().description(\"Add patient\")")));
    // Check that the element "patient_count" contains "1"
    app.expect("textContains", List.of(by("id", "patient_count"), by("accessibility id", "patient_count")), "1", null);
    // Read the text of "{{data.name}}" (save as added)
    vars.put("added", app.read("text", List.of(by("-android uiautomator", "new UiSelector().text(\"" + text(data.get("name")) + "\")"), by("-android uiautomator", "new UiSelector().textContains(\"" + text(data.get("name")) + "\")"), by("-android uiautomator", "new UiSelector().description(\"" + text(data.get("name")) + "\")")), null));
    // If {{vars.added}} equals "{{data.name}}"
    if (compare(vars.get("added"), "equals", data.get("name"))) {
      // Note: Added {{vars.added}} in {{env.ward}}
      System.out.println("Added " + text(vars.get("added")) + " in " + Config.env("ward"));
    }
    // Tick the element "reminders"
    app.setChecked(List.of(by("id", "reminders"), by("accessibility id", "reminders")), true);
    // Check that the element "reminders" is checked
    app.expect("checked", List.of(by("id", "reminders"), by("accessibility id", "reminders")), null, null);
    // Press Enter in the element "patient_name"
    app.press("Enter", List.of(by("id", "patient_name"), by("accessibility id", "patient_name")));
    // Send GET {{env.baseUrl}}/patients
    Api.Result res1 = Api.result(
        given()
            .filter(cookies)
            .when()
            .request("GET", Config.baseUrl() + "/patients")
    );
    assertEquals(200, res1.status(), "status");
  }
}
