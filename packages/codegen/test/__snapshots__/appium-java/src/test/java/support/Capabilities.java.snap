  }

  public static Map<String, Object> get() {
    Map<String, Object> caps = new HashMap<>(J.map("platformName", "Android", "appium:automationName", "UiAutomator2", "appium:app", Config.env("apk"), "appium:enforceAppInstall", true, "appium:avd", "Pixel_8", "appium:avdLaunchTimeout", 300000, "appium:avdReadyTimeout", 300000, "appium:noReset", false, "appium:autoGrantPermissions", true, "appium:disableWindowAnimation", true, "appium:newCommandTimeout", 300, "appium:uiautomator2ServerInstallTimeout", 120000, "appium:adbExecTimeout", 60000, "appium:language", "en"));
