name: Shop Desk tests
on:
  push:
  workflow_dispatch:
jobs:
  tests:
    runs-on: ubuntu-latest
    env:
      BASE_URL: ${{ vars.BASE_URL || 'https://staging.shop.test' }}
      API_VERSION: ${{ vars.API_VERSION || 'v2' }}
      REGION: ${{ vars.REGION || 'eu' }}
      ADMIN_PASSWORD: ${{ secrets.ADMIN_PASSWORD }}
      API_TOKEN: ${{ secrets.API_TOKEN }}
      DB_MAIN_URL: ${{ secrets.DB_MAIN_URL }}
      DB_LOCAL_URL: ${{ secrets.DB_LOCAL_URL }}
      DB_UNKNOWN_URL: ${{ secrets.DB_UNKNOWN_URL }}
      MAILPIT_URL: ${{ vars.MAILPIT_URL || 'http://127.0.0.1:8025' }}
    steps:
      - uses: actions/checkout@v4
      - uses: grafana/setup-k6-action@v1
      - run: k6 run script.js
