// Functional checks of 1 API scenario: one virtual user, one iteration.
// Raise vus/duration in options for a load test (only against systems you own or may test).
import http from 'k6/http';
import encoding from 'k6/encoding';
import { check, fail, group, sleep } from 'k6';
import { uuidv4 } from 'https://jslib.k6.io/k6-utils/1.4.0/index.js';

export const options = {
  vus: 1,
  iterations: 1,
  thresholds: { checks: ['rate==1.0'] },
};

const env = {
  baseUrl: __ENV.BASE_URL || 'https://staging.shop.test',
  'api-version': __ENV.API_VERSION || 'v2',
  region: __ENV.REGION || 'eu',
};
const runId = Date.now().toString(36);
const url = (path) =>
  /^https?:\/\//.test(path) ? path : env.baseUrl.replace(/\/$/, '') + '/' + path.replace(/^\//, '');

// Helpers (StepForge's checks; a small JSONPath).
function field(obj, path) {
  return path.split('.').reduce((o, k) => (o && typeof o === 'object' ? o[k] : undefined), obj);
}
function jsonPath(json, path) {
  const keys = path
    .replace(/^\$\.?/, '')
    .replace(/\[(\d+)\]/g, '.$1')
    .split('.')
    .filter(Boolean);
  return keys.reduce((o, k) => (o && typeof o === 'object' ? o[k] : undefined), json);
}
function body(res) {
  try {
    return res.json();
  } catch (e) {
    return res.body;
  }
}
function pick(res, target) {
  if (target === 'status') return res.status;
  if (target === 'time') return res.timings.duration;
  if (target === 'size') return (res.body || '').length;
  if (target === 'body') return body(res);
  if (target === 'text') return res.body;
  if (target.indexOf('header:') === 0)
    return res.headers[target.slice(7).replace(/(^|-)([a-z])/g, (m, a, b) => a + b.toUpperCase())];
  if (target.indexOf('$') === 0) return jsonPath(body(res), target);
  return undefined;
}
function compare(actual, op, expected) {
  const same = (a, b) => a === b || String(a) === String(b) || JSON.stringify(a) === JSON.stringify(b);
  switch (op) {
    case 'equals':
      return same(actual, expected);
    case 'notEquals':
      return !same(actual, expected);
    case 'contains':
      return Array.isArray(actual)
        ? actual.some((x) => same(x, expected))
        : String(actual).indexOf(String(expected)) >= 0;
    case 'notContains':
      return !compare(actual, 'contains', expected);
    case 'matches':
      return new RegExp(String(expected)).test(String(actual));
    case 'lt':
      return Number(actual) < Number(expected);
    case 'lte':
      return Number(actual) <= Number(expected);
    case 'gt':
      return Number(actual) > Number(expected);
    case 'gte':
      return Number(actual) >= Number(expected);
    case 'exists':
      return actual !== undefined && actual !== null;
    case 'notExists':
      return actual === undefined || actual === null;
    case 'isEmpty':
      return actual === undefined || actual === null || actual === '' || actual.length === 0;
    case 'isNotEmpty':
      return !compare(actual, 'isEmpty');
    case 'lengthEquals':
      return actual != null && actual.length === Number(expected);
    default:
      return false;
  }
}
const random = {
  email: () => 'sf.' + Date.now().toString(36) + Math.floor(Math.random() * 9000 + 1000) + '@example.test',
  uuid: () => uuidv4(),
  number: () => Math.floor(Math.random() * 1000000),
  digits6: () => String(Math.floor(Math.random() * 1000000)).padStart(6, '0'),
  string: () => Math.random().toString(36).slice(2, 10),
  timestamp: () => Date.now(),
};
const NAMES = [
  'Ana Lima',
  'Ben Okafor',
  'Chen Wei',
  'Dana Cruz',
  'Eli Novak',
  'Fatima Khan',
  'Gus Berg',
  'Hana Sato',
];
function fake(kind) {
  const n = NAMES[Math.floor(Math.random() * NAMES.length)];
  switch (kind) {
    case 'name':
      return n;
    case 'firstName':
      return n.split(' ')[0];
    case 'lastName':
      return n.split(' ')[1];
    case 'email':
      return random.email();
    case 'uuid':
      return uuidv4();
    case 'number':
      return random.number();
    case 'phone':
      return (
        '+1-555-' + String(Math.floor(Math.random() * 9000000 + 1000000)).replace(/(\d{3})(\d{4})/, '$1-$2')
      );
    default:
      return random.string();
  }
}
function secret(name) {
  const v = __ENV[name];
  if (!v) fail('Set the ' + name + ' environment variable (k6 run -e ' + name + '=…)');
  return v;
}

export default function () {
  // API › Orders API (P2)
  for (const data of [{}]) {
    group('Orders API', () => {
      const vars = {};
      let last;
      // Get a token
      last = http.request(
        'POST',
        url('/oauth/token'),
        {
          client: 'shop',
          scope: 'orders',
        },
        { headers: {}, tags: { name: 'Get a token' } },
      );
      check(last, {
        'Get a token: status equals 200': (r) => compare(pick(r, 'status'), 'equals', 200),
      });
      vars.token = body(last);
      // TODO(StepForge): api.request: the JSON Schema check on "$" is not exported
      last = http.request(
        'POST',
        url(`/api/${env['api-version']}/orders`) + `?dryRun=${encodeURIComponent(false)}`,
        JSON.stringify({
          items: [
            {
              sku: 'A-1',
              qty: 2,
            },
          ],
          note: 'it\'s "quoted" & {braced}',
          email: random.email(),
          at: random.timestamp(),
        }),
        {
          headers: {
            'X-Request-Id': random.uuid(),
            'X-Region': env.region,
            Authorization: `Bearer ${secret('API_TOKEN')}`,
            'Content-Type': 'application/json',
          },
          tags: { name: 'Create an order' },
        },
      );
      check(last, {
        'Create an order: status equals 201': (r) => compare(pick(r, 'status'), 'equals', 201),
        'Create an order: $.id exists': (r) => compare(pick(r, '$.id'), 'exists', null),
        'Create an order: $.items[*].sku contains "A-1"': (r) =>
          compare(pick(r, '$.items[*].sku'), 'contains', 'A-1'),
        'Create an order: header:content-type contains "json"': (r) =>
          compare(pick(r, 'header:content-type'), 'contains', 'json'),
        'Create an order: time lte 800': (r) => compare(pick(r, 'time'), 'lte', 800),
        'Create an order: $.total inRange [0,1000]': (r) => compare(pick(r, '$.total'), 'inRange', [0, 1000]),
      });
      vars.order = body(last);
      // Read the location header of the response (save as location)
      vars.location = pick(last, 'header:location');
      // Read the response status (save as code)
      vars.code = pick(last, 'status');
      // Basic auth
      last = http.request('GET', url('/admin'), null, {
        headers: { Authorization: `Basic ${encoding.b64encode('admin' + ':' + secret('ADMIN_PASSWORD'))}` },
        tags: { name: 'Basic auth' },
      });
      // API key in query
      last = http.request('GET', url('/reports') + `?key=${encodeURIComponent(secret('API_TOKEN'))}`, null, {
        headers: {},
        tags: { name: 'API key in query' },
      });
      // API key header
      last = http.request('DELETE', url(`/api/orders/${field(vars, 'order.id')}`), null, {
        headers: { 'x-api-key': secret('API_TOKEN') },
        tags: { name: 'API key header' },
      });
      // Cookie
      last = http.request('GET', url('/me'), null, {
        headers: { Cookie: `sid=${'abc'}` },
        tags: { name: 'Cookie' },
      });
      // TODO(StepForge): api.request: auth type "oauth2" is not exported; set the header yourself
      last = http.request('GET', url('/x'), null, { headers: {}, tags: { name: 'OAuth (not exported)' } });
      // Upload
      last = http.request(
        'POST',
        url('/files'),
        {
          name: 'a.txt',
        },
        { headers: {}, tags: { name: 'Upload' } },
      );
      // Raw text
      last = http.request('PUT', url('https://other.test/raw'), `plain ${data.missing} text`, {
        headers: {},
        tags: { name: 'Raw text' },
      });
      // GraphQL
      last = http.request(
        'POST',
        url('/graphql') +
          `?0=${encodeURIComponent('q')}&1=${encodeURIComponent('u')}&2=${encodeURIComponent('e')}&3=${encodeURIComponent('r')}&4=${encodeURIComponent('y')}&5=${encodeURIComponent(' ')}&6=${encodeURIComponent('{')}&7=${encodeURIComponent(' ')}&8=${encodeURIComponent('m')}&9=${encodeURIComponent('e')}&10=${encodeURIComponent(' ')}&11=${encodeURIComponent('{')}&12=${encodeURIComponent(' ')}&13=${encodeURIComponent('i')}&14=${encodeURIComponent('d')}&15=${encodeURIComponent(' ')}&16=${encodeURIComponent('}')}&17=${encodeURIComponent(' ')}&18=${encodeURIComponent('}')}`,
        JSON.stringify({
          query: 'query { me { id } }',
          variables: {
            first: 1,
          },
        }),
        { headers: { 'Content-Type': 'application/json' }, tags: { name: 'GraphQL' } },
      );
      check(last, {
        'GraphQL: $.data.me.id isNotEmpty': (r) => compare(pick(r, '$.data.me.id'), 'isNotEmpty', null),
        'GraphQL: $.errors notExists': (r) => compare(pick(r, '$.errors'), 'notExists', null),
      });
      // If {{vars.code}} equals "201"
      if (compare(vars.code, 'equals', 201)) {
        // Note: Created {{vars.order.id}}
        console.log(`Created ${field(vars, 'order.id')}`);
      } else {
        // Note: Not created
        console.log('Not created');
      }
      // Repeat 3 times
      for (let index = 0; index < Number(3); index++) {
        vars.index = index;
        // Send GET /ping?i={{vars.index}}
        last = http.request('GET', url(`/ping?i=${vars.index}`), null, {
          headers: {},
          tags: { name: 'Send GET /ping?i={{vars.index}}' },
        });
      }
      // Repeat for each line in {{vars.order.items}}
      field(vars, 'order.items').forEach((item, index) => {
        vars.line = item;
        vars.index = index;
        // Note: {{vars.line.sku}}
        console.log(field(vars, 'line.sku'));
      });
      // Remember "[object Object]" as payload
      vars.payload = {
        a: [1, true, null],
        b: runId,
      };
      // Generate a random pattern (save as ref)
      vars.ref = fake('pattern');
      // Generate a random date (save as due)
      vars.due = fake('date');
      // Wait 250 ms
      sleep(0.25);
      // Run a script (save as double)
      // TODO(StepForge): script step not exported (k6 runs HTTP requests only)
    });
  }
}
