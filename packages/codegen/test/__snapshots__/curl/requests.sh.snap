# Repeat 3 times
# Loop, item 1 of 3
save index "$(jq -n --arg v "0" '$v')"
# Send GET /ping?i={{vars.index}}
# Send GET /ping?i={{vars.index}}
request -X GET \
  "${BASE_URL}/ping?i=$(value index)"
# Loop, item 2 of 3
save index "$(jq -n --arg v "1" '$v')"
# Send GET /ping?i={{vars.index}}
# Send GET /ping?i={{vars.index}}
request -X GET \
  "${BASE_URL}/ping?i=$(value index)"
# Loop, item 3 of 3
save index "$(jq -n --arg v "2" '$v')"
# Send GET /ping?i={{vars.index}}
# Send GET /ping?i={{vars.index}}
request -X GET \
