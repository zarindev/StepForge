request -X GET \
  -u "admin:${ADMIN_PASSWORD}" \
  "${BASE_URL}/admin"
# API key in query
# API key in query
request -X GET \
  --url-query "key=${API_TOKEN}" \
  "${BASE_URL}/reports"
# API key header
# API key header
request -X DELETE \
  -H "x-api-key: ${API_TOKEN}" \
  "${BASE_URL}/api/orders/$(value order '.id')"
# Cookie
# Cookie
request -X GET \
  --cookie "sid=abc" \
  "${BASE_URL}/me"
# TODO(StepForge): api.request: auth type "oauth2" is not exported; set the header yourself
# OAuth (not exported)
request -X GET \
  "${BASE_URL}/x"
# Upload
# Upload
request -X POST \
  -F "name=a.txt" \
  "${BASE_URL}/files"
# Raw text
# Raw text
request -X PUT \
  --data-binary "plain ${DATA_MISSING} text" \
  "https://other.test/raw"
# GraphQL
# GraphQL
request -X POST \
  --url-query "0=q" \
  --url-query "1=u" \
  --url-query "2=e" \
  --url-query "3=r" \
  --url-query "4=y" \
  --url-query "5= " \
  --url-query "6={" \
  --url-query "7= " \
  --url-query "8=m" \
  --url-query "9=e" \
  --url-query "10= " \
  --url-query "11={" \
  --url-query "12= " \
  --url-query "13=i" \
  --url-query "14=d" \
  --url-query "15= " \
  --url-query "16=}" \
  --url-query "17= " \
  --url-query "18=}" \
  -H "Content-Type: application/json" \
  --data-binary "$(jq -n  '{"query": "query { me { id } }", "variables": {"first": 1}}')" \
  "${BASE_URL}/graphql"
# TODO(StepForge): check $.data.me.id isNotEmpty (not supported in the cURL script)
expect_json '.errors' notExists
# If {{vars.code}} equals "201"
# Condition (not supported by the cURL script): steps listed once
# Note: Created {{vars.order.id}}
