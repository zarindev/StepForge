#!/usr/bin/env bash
# Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
# The API scenarios as cURL requests, with their checks. Needs bash, curl 7.87+ and jq.
set -euo pipefail

[ -n "${BASE_URL:-}" ] || BASE_URL='https://staging.shop.test'
[ -n "${API_VERSION:-}" ] || API_VERSION='v2'
[ -n "${REGION:-}" ] || REGION='eu'
ADMIN_PASSWORD="${ADMIN_PASSWORD:?Set ADMIN_PASSWORD (a secret; see .env.example)}"
API_TOKEN="${API_TOKEN:?Set API_TOKEN (a secret; see .env.example)}"
RUN_ID="$(date +%s)"
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
RESPONSE="$WORK/response"
FAILED=0

# Captured values are kept as JSON files and read back with jq.
save() { printf '%s' "$2" > "$WORK/$1.json"; }
value() { jq -r "${2:-.}" "$WORK/$1.json"; }
json() { jq -c "${2:-.}" "$WORK/$1.json" 2>/dev/null || echo null; }
scenario() { echo; echo "▶ $1"; }
# Simple generated data, like StepForge's "Generate data" step.
fake() {
  local names=("Ana Lima" "Ben Okafor" "Chen Wei" "Dana Cruz" "Eli Novak" "Fatima Khan" "Gus Berg" "Hana Sato")
  case "$1" in
    name) echo "${names[RANDOM % ${#names[@]}]}" ;;
    firstName) echo "${names[RANDOM % ${#names[@]}]% *}" ;;
    lastName) echo "${names[RANDOM % ${#names[@]}]#* }" ;;
    email) echo "sf.$(date +%s)${RANDOM}@example.test" ;;
    uuid) uuidgen | tr "[:upper:]" "[:lower:]" ;;
    phone) printf "+1-555-%03d-%04d\n" $((RANDOM % 1000)) $((RANDOM % 10000)) ;;
    number) echo $((RANDOM % 1001)) ;;
    *) echo "$(date +%s)${RANDOM}" ;;
  esac
}
request() { STATUS="$(curl -sS -o "$RESPONSE" -w '%{http_code}' "$@")"; }
pass() { echo "  ✓ $1"; }
fail() { echo "  ✗ $1"; FAILED=1; }
expect_status() { [ "$STATUS" = "$1" ] && pass "status $1" || fail "status $1 (got $STATUS)"; }
# A SOAP fault right inside the envelope's Body fails the check, as in StepForge.
expect_no_fault() {
  local flat; flat="$(tr -d '\r\n' < "$RESPONSE")"
  if printf '%s' "$flat" | grep -Eq '<([A-Za-z0-9_.-]+:)?Body[^>]*>[[:space:]]*<([A-Za-z0-9_.-]+:)?Fault[[:space:]>/]'; then
    fail "no SOAP fault (got: $(printf '%s' "$flat" | sed -nE 's/.*<([A-Za-z0-9_.-]+:)?(faultstring|Text)[^>]*>([^<]*)<.*/\3/p'))"
  else pass "no SOAP fault"; fi
}
# OAuth2 client credentials (URL, client id, secret, scope) into TOKEN, kept until shortly before they expire.
oauth2_token() {
  local file; file="$WORK/token-$(printf '%s' "$1|$2|$4" | cksum | cut -d' ' -f1)"
  if [ -f "$file" ] && [ "$(cut -d' ' -f1 "$file")" -gt "$(date +%s)" ]; then TOKEN="$(cut -d' ' -f2 "$file")"; return; fi
  local args=(-sS -X POST -u "$2:$3" --data-urlencode grant_type=client_credentials)
  [ -n "$4" ] && args+=(--data-urlencode "scope=$4")
  local reply; reply="$(curl "${args[@]}" "$1" || true)"
  TOKEN="$(printf '%s' "$reply" | jq -r '.access_token // empty' 2>/dev/null || true)"
  if [ -z "$TOKEN" ]; then fail "OAuth2 token from $1"; return; fi
  local life; life="$(printf '%s' "$reply" | jq -r '.expires_in // 300')"
  [ "$life" -gt 60 ] 2>/dev/null || life=60
  echo "$(( $(date +%s) + life - 30 )) $TOKEN" > "$file"
}
expect_json() {
  local actual; actual="$(jq -r "$1 // empty" "$RESPONSE" 2>/dev/null || true)"
  case "$2" in
    exists) [ -n "$actual" ] && pass "$1 exists" || fail "$1 exists" ;;
    notExists) [ -z "$actual" ] && pass "$1 does not exist" || fail "$1 does not exist (got $actual)" ;;
    equals) [ "$actual" = "$3" ] && pass "$1 = $3" || fail "$1 = $3 (got $actual)" ;;
    contains) [[ "$actual" == *"$3"* ]] && pass "$1 contains $3" || fail "$1 contains $3 (got $actual)" ;;
    matches) [[ "$actual" =~ $3 ]] && pass "$1 matches $3" || fail "$1 matches $3 (got $actual)" ;;
  esac
}

