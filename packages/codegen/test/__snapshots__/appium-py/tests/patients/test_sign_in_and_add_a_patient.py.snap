# Generated by StepForge — by Md Zarin Tasnim · CareClinic mobile · 2026-10-15
# Scenario: Patients › Sign in and add a patient (P1, #smoke)

import pytest

from support.config import env, secret
from support.helpers import compare, text
from support import api


@pytest.mark.smoke
@pytest.mark.p1
@pytest.mark.parametrize(
    "data",
    [{"name": "Ana Silva"}, {"name": "Alexandra Johnson"}],
    ids=["TC-1 Short name", "TC-2 Long name"],
)
def test_sign_in_and_add_a_patient(app, http, data):
    """Sign in and add a patient"""
    vars = {}
    # Type "nurse@careclinic.test" into the field with placeholder "Email"
    app.fill([("xpath", "//*[@hint='Email']")], "nurse@careclinic.test")
    # Type "{{secret.nursePassword}}" into the element "password"
    app.fill([("id", "password"), ("accessibility id", "password")], secret("NURSE_PASSWORD"))
    # Click the "Sign in" button
    app.click([("xpath", "//*[@class='android.widget.Button' or @class='android.widget.ImageButton'][@text='Sign in' or @content-desc='Sign in' or @hint='Sign in']")])
    # Check that the element "patient_count" reads "No patients yet"
    app.expect("text", [("id", "patient_count"), ("accessibility id", "patient_count")], expected="No patients yet")
    # Type "{{data.name}}" into the "Patient name" field
    app.fill([("accessibility id", "Patient name"), ("xpath", "//*[@hint='Patient name']")], text(data.get("name")))
    # Tap "Add patient"
    app.click([("-android uiautomator", "new UiSelector().text(\"Add patient\")"), ("-android uiautomator", "new UiSelector().textContains(\"Add patient\")"), ("-android uiautomator", "new UiSelector().description(\"Add patient\")")])
    # Check that the element "patient_count" contains "1"
    app.expect("textContains", [("id", "patient_count"), ("accessibility id", "patient_count")], expected="1")
    # Read the text of "{{data.name}}" (save as added)
    vars["added"] = app.read("text", [("-android uiautomator", f"new UiSelector().text(\"{text(data.get('name'))}\")"), ("-android uiautomator", f"new UiSelector().textContains(\"{text(data.get('name'))}\")"), ("-android uiautomator", f"new UiSelector().description(\"{text(data.get('name'))}\")")])
    # If {{vars.added}} equals "{{data.name}}"
    if compare(vars.get("added"), "equals", data.get("name")):
        # Note: Added {{vars.added}} in {{env.ward}}
        print(f"Added {text(vars.get('added'))} in {text(env['ward'])}")
    # Tick the element "reminders"
    app.set_checked([("id", "reminders"), ("accessibility id", "reminders")], True)
    # Check that the element "reminders" is checked
    app.expect("checked", [("id", "reminders"), ("accessibility id", "reminders")])
    # Press Enter in the element "patient_name"
    app.press("Enter", [("id", "patient_name"), ("accessibility id", "patient_name")])
    # Send GET {{env.baseUrl}}/patients
    res1 = api.call(
        http, "GET", f"{text(env['base_url'])}/patients",
    )
    assert res1["status"] == 200, "status"
