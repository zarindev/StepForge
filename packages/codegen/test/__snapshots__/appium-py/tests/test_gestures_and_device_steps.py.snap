# Scenario: Gestures and device steps (P2)
import time

import pytest

from support.helpers import text


@pytest.mark.p2
def test_gestures_and_device_steps(app):
    """Gestures and device steps"""
    vars = {}
    # Open careclinic://patients
    app.deep_link("careclinic://patients")
    # TODO(StepForge): ui.navigate: phone and desktop apps have no pages to open; use a deep link (myapp://…) instead
    # Scroll down until "support@careclinic.test" shows
    app.scroll_to([("-android uiautomator", "new UiSelector().text(\"support@careclinic.test\")"), ("-android uiautomator", "new UiSelector().textContains(\"support@careclinic.test\")"), ("-android uiautomator", "new UiSelector().description(\"support@careclinic.test\")")], "down", 5)
    # Swipe up
    app.swipe("up", 0.75)
    # Swipe left on the element "patient_list"
    app.swipe_on([("id", "patient_list"), ("accessibility id", "patient_list")], "left", 0.5)
    # Drag "Ana Silva" onto another element
    app.drag([("-android uiautomator", "new UiSelector().text(\"Ana Silva\")"), ("-android uiautomator", "new UiSelector().textContains(\"Ana Silva\")"), ("-android uiautomator", "new UiSelector().description(\"Ana Silva\")")], [("id", "trash"), ("accessibility id", "trash")])
    # Long-press "Ana Silva"
    app.long_press([("-android uiautomator", "new UiSelector().text(\"Ana Silva\")"), ("-android uiautomator", "new UiSelector().textContains(\"Ana Silva\")"), ("-android uiautomator", "new UiSelector().description(\"Ana Silva\")")], 1500)
    # Double-click the element "avatar"
    app.double_click([("id", "avatar"), ("accessibility id", "avatar")])
    # Hide the keyboard
    app.hide_keyboard()
    # Go back
    app.back()
    # Turn the device to landscape
    app.rotate("landscape")
    # Put the app in the background for 2 s
    app.background_app(2)
    # Close the app
    app.close_app()
    # Open the app
    app.launch_app()
    # Reset the app’s data
    app.reset_app()
    # Open the link careclinic://patients/42
    app.deep_link("careclinic://patients/42")
    # Set the device location to 51.5072, -0.1276
    app.set_location(51.5072, -0.1276)
    # Grant the camera permission
    app.permission("camera", True)
    # Send a notification "Reminder"
    app.push_notification("Reminder", "Ana at 10:00")
    # Accept the next dialog
    app.handle_dialog(True, None)
    # Press "Not now" in the dialog
    app.handle_dialog(False, "Not now")
    # Choose Patients > Clear List from the menu
    app.menu("Patients > Clear List")
    # Select "North" in the element "ward"
    app.select([("id", "ward"), ("accessibility id", "ward")], "North")
    # Wait until the element "spinner" is hidden
    app.wait_for([("id", "spinner"), ("accessibility id", "spinner")], "hidden")
    # Patients list
    app.screenshot("patientsList")
    # TODO(StepForge): ui.click: its locators (CSS) do not exist in phone and desktop apps; add an id, text, label or XPath locator
    # TODO(StepForge): ui.click: image locators (pictures) are not exported; add an id, text, label locator
    # Click the element "#save"
    app.click([("xpath", "//*[@text=\"Save\"]")])
    # TODO(StepForge): ui.hover: this is a web-page step; phone and desktop apps have no equivalent
    # TODO(StepForge): ui.switchTab: this is a web-page step; phone and desktop apps have no equivalent
    # TODO(StepForge): ui.assert: phone and desktop apps have no URL or page title to check
    # Repeat 2 times
    for index in range(2):
        vars["index"] = index
        # Swipe up
        app.swipe("up", 0.75)
    # Wait 500 ms
    time.sleep(0.5)
