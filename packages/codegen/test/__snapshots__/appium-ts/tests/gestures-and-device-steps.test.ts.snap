// Generated by StepForge — by Md Zarin Tasnim · CareClinic mobile · 2026-10-15
// Scenario: Gestures and device steps (P2)
import { startApp, type App } from '../support/app';
import { APPIUM_URL, CAPABILITIES, PLATFORM } from '../support/config';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

describe('Gestures and device steps', function () {
  let app: App;
  beforeEach(async () => {
    app = await startApp(APPIUM_URL, CAPABILITIES, PLATFORM);
  });
  afterEach(async function () {
    await app?.end(this.currentTest);
  });

  it('Gestures and device steps @p2', async () => {
    const vars: Vars = {};
    // Open careclinic://patients
    await app.deepLink('careclinic://patients');
    // TODO(StepForge): ui.navigate: phone and desktop apps have no pages to open; use a deep link (myapp://…) instead
    // Scroll down until "support@careclinic.test" shows
    await app.scrollTo(
      [
        ['-android uiautomator', 'new UiSelector().text("support@careclinic.test")'],
        ['-android uiautomator', 'new UiSelector().textContains("support@careclinic.test")'],
        ['-android uiautomator', 'new UiSelector().description("support@careclinic.test")'],
      ],
      'down',
      5,
    );
    // Swipe up
    await app.swipe('up', 0.75);
    // Swipe left on the element "patient_list"
    await app.swipeOn(
      [
        ['id', 'patient_list'],
        ['accessibility id', 'patient_list'],
      ],
      'left',
      0.5,
    );
    // Drag "Ana Silva" onto another element
    await app.drag(
      [
        ['-android uiautomator', 'new UiSelector().text("Ana Silva")'],
        ['-android uiautomator', 'new UiSelector().textContains("Ana Silva")'],
        ['-android uiautomator', 'new UiSelector().description("Ana Silva")'],
      ],
      [
        ['id', 'trash'],
        ['accessibility id', 'trash'],
      ],
    );
    // Long-press "Ana Silva"
    await app.longPress(
      [
        ['-android uiautomator', 'new UiSelector().text("Ana Silva")'],
        ['-android uiautomator', 'new UiSelector().textContains("Ana Silva")'],
        ['-android uiautomator', 'new UiSelector().description("Ana Silva")'],
      ],
      1500,
    );
    // Double-click the element "avatar"
    await app.doubleClick([
      ['id', 'avatar'],
      ['accessibility id', 'avatar'],
    ]);
    // Hide the keyboard
    await app.hideKeyboard();
    // Go back
    await app.back();
    // Turn the device to landscape
    await app.rotate('landscape');
    // Put the app in the background for 2 s
    await app.backgroundApp(2);
    // Close the app
    await app.closeApp();
    // Open the app
    await app.launchApp();
    // Reset the app’s data
    await app.resetApp();
    // Open the link careclinic://patients/42
    await app.deepLink('careclinic://patients/42');
    // Set the device location to 51.5072, -0.1276
    await app.setLocation(51.5072, -0.1276);
    // Grant the camera permission
    await app.permission('camera', true);
    // Send a notification "Reminder"
    await app.pushNotification('Reminder', 'Ana at 10:00');
    // Accept the next dialog
    await app.handleDialog(true, null);
    // Press "Not now" in the dialog
    await app.handleDialog(false, 'Not now');
    // Choose Patients > Clear List from the menu
    await app.menu('Patients > Clear List');
    // Select "North" in the element "ward"
    await app.select(
      [
        ['id', 'ward'],
        ['accessibility id', 'ward'],
      ],
      'North',
    );
    // Wait until the element "spinner" is hidden
    await app.waitFor(
      [
        ['id', 'spinner'],
        ['accessibility id', 'spinner'],
      ],
      'hidden',
    );
    // Patients list
    await app.screenshot('patientsList');
    // TODO(StepForge): ui.click: its locators (CSS) do not exist in phone and desktop apps; add an id, text, label or XPath locator
    // TODO(StepForge): ui.click: image locators (pictures) are not exported; add an id, text, label locator
    // Click the element "#save"
    await app.click([['xpath', '//*[@text="Save"]']]);
    // TODO(StepForge): ui.hover: this is a web-page step; phone and desktop apps have no equivalent
    // TODO(StepForge): ui.switchTab: this is a web-page step; phone and desktop apps have no equivalent
    // TODO(StepForge): ui.assert: phone and desktop apps have no URL or page title to check
    // Repeat 2 times
    for (let index = 0; index < 2; index++) {
      vars.index = index;
      // Swipe up
      await app.swipe('up', 0.75);
    }
    // Wait 500 ms
    await new Promise((resolve) => setTimeout(resolve, 500));
  });
});
