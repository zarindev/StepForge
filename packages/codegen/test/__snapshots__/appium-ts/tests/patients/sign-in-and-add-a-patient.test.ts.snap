// Generated by StepForge — by Md Zarin Tasnim · CareClinic mobile · 2026-10-15
// Scenario: Patients › Sign in and add a patient (P1, #smoke)
import { startApp, type App } from '../../support/app';
import { APPIUM_URL, CAPABILITIES, PLATFORM, env, secret } from '../../support/config';
import { check, compare, pick } from '../../support/helpers';
import { api } from '../../support/api';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

const testCases: { code: string; title: string; data: Vars }[] = [
  { code: 'TC-1', title: 'Short name', data: { name: 'Ana Silva' } },
  { code: 'TC-2', title: 'Long name', data: { name: 'Alexandra Johnson' } },
];

describe('Patients › Sign in and add a patient', function () {
  let app: App;
  beforeEach(async () => {
    app = await startApp(APPIUM_URL, CAPABILITIES, PLATFORM);
  });
  afterEach(async function () {
    await app?.end(this.currentTest);
  });

  for (const { code, title, data } of testCases) {
    it(`${code} ${title} @smoke @p1`, async () => {
      const vars: Vars = {};
      // Type "nurse@careclinic.test" into the field with placeholder "Email"
      await app.fill([['xpath', "//*[@hint='Email']"]], 'nurse@careclinic.test');
      // Type "{{secret.nursePassword}}" into the element "password"
      await app.fill(
        [
          ['id', 'password'],
          ['accessibility id', 'password'],
        ],
        secret('NURSE_PASSWORD'),
      );
      // Click the "Sign in" button
      await app.click([
        [
          'xpath',
          "//*[@class='android.widget.Button' or @class='android.widget.ImageButton'][@text='Sign in' or @content-desc='Sign in' or @hint='Sign in']",
        ],
      ]);
      // Check that the element "patient_count" reads "No patients yet"
      await app.expect(
        'text',
        [
          ['id', 'patient_count'],
          ['accessibility id', 'patient_count'],
        ],
        'No patients yet',
      );
      // Type "{{data.name}}" into the "Patient name" field
      await app.fill(
        [
          ['accessibility id', 'Patient name'],
          ['xpath', "//*[@hint='Patient name']"],
        ],
        String(data.name),
      );
      // Tap "Add patient"
      await app.click([
        ['-android uiautomator', 'new UiSelector().text("Add patient")'],
        ['-android uiautomator', 'new UiSelector().textContains("Add patient")'],
        ['-android uiautomator', 'new UiSelector().description("Add patient")'],
      ]);
      // Check that the element "patient_count" contains "1"
      await app.expect(
        'textContains',
        [
          ['id', 'patient_count'],
          ['accessibility id', 'patient_count'],
        ],
        '1',
      );
      // Read the text of "{{data.name}}" (save as added)
      vars.added = await app.read('text', [
        ['-android uiautomator', `new UiSelector().text("${data.name}")`],
        ['-android uiautomator', `new UiSelector().textContains("${data.name}")`],
        ['-android uiautomator', `new UiSelector().description("${data.name}")`],
      ]);
      // If {{vars.added}} equals "{{data.name}}"
      if (compare(vars.added, 'equals', data.name)) {
        // Note: Added {{vars.added}} in {{env.ward}}
        console.log(`Added ${vars.added} in ${env.ward}`);
      }
      // Tick the element "reminders"
      await app.setChecked(
        [
          ['id', 'reminders'],
          ['accessibility id', 'reminders'],
        ],
        true,
      );
      // Check that the element "reminders" is checked
      await app.expect('checked', [
        ['id', 'reminders'],
        ['accessibility id', 'reminders'],
      ]);
      // Press Enter in the element "patient_name"
      await app.press('Enter', [
        ['id', 'patient_name'],
        ['accessibility id', 'patient_name'],
      ]);
      // Send GET {{env.baseUrl}}/patients
      const res1 = await api({
        method: 'GET',
        url: `${env.baseUrl}/patients`,
      });
      check(pick(res1, 'status'), 'equals', 200, 'status equals');
    });
  }
});
