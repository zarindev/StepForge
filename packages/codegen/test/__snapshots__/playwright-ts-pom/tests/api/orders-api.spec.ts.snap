// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: API › Orders API (P2, #api)
import { test, expect } from '@playwright/test';
import { env, secret } from '../../support/config';
import { check, compare, pick, fake, field, random, runId } from '../../support/helpers';
import { api, basicAuth, oauth2Token } from '../../support/api';
import { pageCondition } from '../../support/web';
import { expectSchema } from '../../support/schema';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

test.describe('API › Orders API', () => {
  test('Orders API', { tag: ['@api', '@p2'] }, async ({ page, request }) => {
    const data: Vars = {};
    const vars: Vars = {};
    // Get a token
    const res1 = await api(request, {
      method: 'POST',
      url: '/oauth/token',
      form: {
        client: 'shop',
        scope: 'orders',
      },
    });
    expect(res1.status, 'status').toBe(200);
    vars.token = res1.body;
    // Create an order
    const res2 = await api(request, {
      method: 'POST',
      url: `/api/${env['api-version']}/orders`,
      headers: {
        'X-Request-Id': String(random.uuid()),
        'X-Region': env.region,
        Authorization: `Bearer ${secret('API_TOKEN')}`,
      },
      params: { dryRun: false },
      json: {
        items: [
          {
            sku: 'A-1',
            qty: 2,
          },
        ],
        note: 'it\'s "quoted" & {braced}',
        email: random.email(),
        at: random.timestamp(),
      },
    });
    expect(res2.status, 'status').toBe(201);
    check(pick(res2, '$.id'), 'exists', null, '$.id exists');
    check(pick(res2, '$.items[*].sku'), 'contains', 'A-1', '$.items[*].sku contains');
    check(pick(res2, 'header:content-type'), 'contains', 'json', 'header:content-type contains');
    check(pick(res2, 'time'), 'lte', 800, 'time lte');
    check(pick(res2, '$.total'), 'inRange', [0, 1000], '$.total inRange');
    expectSchema(
      res2.body,
      {
        type: 'object',
      },
      '$ matches the JSON schema',
    );
    vars.order = res2.body;
    // Read the location header of the response (save as location)
    vars.location = pick(res2, 'header:location');
    // Read the response status (save as code)
    vars.code = pick(res2, 'status');
    // Basic auth
    const res3 = await api(request, {
      method: 'GET',
      url: '/admin',
      headers: { Authorization: basicAuth('admin', secret('ADMIN_PASSWORD')) },
    });
    // API key in query
    const res4 = await api(request, {
      method: 'GET',
      url: '/reports',
      params: { key: secret('API_TOKEN') },
    });
    // API key header
    const res5 = await api(request, {
      method: 'DELETE',
      url: `/api/orders/${field(vars, 'order.id')}`,
      headers: { 'x-api-key': secret('API_TOKEN') },
    });
    // Cookie
    const res6 = await api(request, {
      method: 'GET',
      url: '/me',
      headers: { Cookie: `sid=${'abc'}` },
    });
    // OAuth2 client credentials
    const token1 = await oauth2Token(request, {
      tokenUrl: 'https://id.test/token',
      clientId: 'shop-tests',
      clientSecret: secret('API_TOKEN'),
      scope: 'orders:read',
    });
    const res7 = await api(request, {
      method: 'GET',
      url: '/x',
      headers: { Authorization: `Bearer ${token1}` },
    });
    expect(res7.status, 'status').toBe(200);
    // Upload
    const res8 = await api(request, {
      method: 'POST',
      url: '/files',
      multipart: {
        name: 'a.txt',
      },
    });
    // Raw text
    const res9 = await api(request, {
      method: 'PUT',
      url: 'https://other.test/raw',
      data: `plain ${data.missing} text`,
    });
    // GraphQL
    const res10 = await api(request, {
      method: 'POST',
      url: '/graphql',
      json: {
        query: 'query { me { id } }',
        variables: {
          first: 1,
        },
      },
    });
    check(pick(res10, '$.data.me.id'), 'isNotEmpty', null, '$.data.me.id isNotEmpty');
    check(pick(res10, '$.errors'), 'notExists', null, '$.errors notExists');
    // If {{vars.code}} equals "201"
    if (compare(vars.code, 'equals', 201)) {
      // Note: Created {{vars.order.id}}
      console.log(`Created ${field(vars, 'order.id')}`);
    } else {
      // Note: Not created
      console.log('Not created');
    }
    // Repeat 3 times
    for (let index = 0; index < 3; index++) {
      vars.index = index;
      // Send GET /ping?i={{vars.index}}
      const res11 = await api(request, {
        method: 'GET',
        url: `/ping?i=${vars.index}`,
      });
    }
    // Repeat for each line in {{vars.order.items}}
    for (const [index, item] of (field(vars, 'order.items') as unknown[]).entries()) {
      vars.line = item;
      vars.index = index;
      // Note: {{vars.line.sku}}
      console.log(field(vars, 'line.sku'));
    }
    // Repeat while the "Load more" button is visible
    let pass1 = 0;
    for (; pass1 < 100; pass1++) {
      vars.index = pass1;
      if (!(await pageCondition(page.getByRole('button', { name: 'Load more', exact: true }), 'visible')))
        break;
      // Note: more
      console.log('more');
    }
    if (pass1 >= 100) throw new Error('Stopped after the limit of 100 pass(es); the condition still held');
    // If "Out of stock" is on the page
    if (await pageCondition(page.getByText('Out of stock', { exact: true }), 'present')) {
      // Note: oos
      console.log('oos');
    }
    // Poll until three
    let pass2 = 0;
    for (; pass2 < 5; pass2++) {
      vars.index = pass2;
      if (!compare(vars.index, 'lt', 3)) break;
      // Send GET /poll
      const res12 = await api(request, {
        method: 'GET',
        url: '/poll',
      });
    }
    if (pass2 >= 5) throw new Error('Stopped after the limit of 5 pass(es); the condition still held');
    // Remember "[object Object]" as payload
    vars.payload = {
      a: [1, true, null],
      b: runId,
    };
    // Generate a random pattern (save as ref)
    vars.ref = fake('pattern', { pattern: 'ORD-####' });
    // Generate a random date (save as due)
    vars.due = fake('date', { direction: 'future', days: 10 });
    // Wait 250 ms
    await page.waitForTimeout(250);
    // Run a script (save as double)
    vars.double = await (async (vars: Vars, data: Vars) => {
      return vars.total * 2;
    })(vars, data);
  });
});
