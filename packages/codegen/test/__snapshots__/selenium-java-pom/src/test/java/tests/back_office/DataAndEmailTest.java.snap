class DataAndEmailTest extends ApiTest {
  static Stream<Arguments> testCases() {
    return Stream.of(
        Arguments.of("TC-BAC-001 Default", J.map("email", "qa@shop.test"))
    );
  }

  @ParameterizedTest(name = "{0}")
  @MethodSource("testCases")
  void dataAndEmail(String testCase, Map<String, Object> data) throws Exception {
    Instant testStart = Instant.now();
    Map<String, Object> vars = new HashMap<>();
    // Order count
    // SQL also in sql/dataAndEmail/orderCount.sql
    Db.Result db1 = Db.query("main", """
SELECT COUNT(*) AS n
FROM orders
WHERE email = $1""", J.list(data.get("email")));
    check(pick(db1, "value"), "gte", 1, "value gte");
    check(pick(db1, "column:n"), "noNulls", null, "column:n noNulls");
    check(pick(db1, "rows[0].n"), "gt", 0, "rows[0].n gt");
    vars.put("counts", db1.rows());
    // Read value from the query result (save as n)
    vars.put("n", pick(db1, "value"));
    // Run a SQL script on local
    // SQL also in sql/dataAndEmail/script.sql
    Db.Result db2 = Db.script("local", """
DELETE FROM carts;
VACUUM;""");
    // Call the procedure refresh_totals
    // SQL also in sql/dataAndEmail/procedure.sql
    Db.Result db3 = Db.query("main", "CALL refresh_totals($1, $2)", J.list(1, "x"));
    // TODO(StepForge): db.query: SQL Server helpers are not generated; the SQL file is exported for reference
    // TODO(StepForge): db.mongoFind: MongoDB steps are not exported; use the MongoDB driver of the target language
    // TODO(StepForge): db.dataQualityCheck: the data-quality audit runs only in StepForge
    // Run the SQL query "SELECT ?" on unknown
    // SQL also in sql/dataAndEmail/query2.sql
    Db.Result db4 = Db.query("unknown", "SELECT ?", J.list(1));
    // Wait for an email to {{data.email}} with subject "Your order" (save as mail)
    Map<String, Object> email1 = Mail.waitForEmail(testStart, J.map("to", text(data.get("email")), "subject", "Your order"), 15000);
    vars.put("mail", email1);
    // Check that the subject contains "order" and the body contains "Thank you" and it comes from shop@ and it has a link and it has the attachment "invoice"
    Mail.assertEmail(email1, J.map("subjectContains", "order", "bodyContains", "Thank you", "from", "shop@", "hasLink", true, "hasAttachment", "invoice"));
    // Read the one-time code from the email (save as otp)
    vars.put("otp", Mail.otp(email1));
    // Read the "track" link from the email (save as trackUrl)
    vars.put("trackUrl", Mail.link(email1, "track", 0));
    // Read "Order (\w+)" from the email (save as orderNo)
    vars.put("orderNo", Mail.extract(email1, "Order (\\w+)"));
    // Open the "track" link in the email
    Api.Result res1 = Api.result(given().filter(cookies).when().get(Mail.link(email1, "track", 0)));
    // TODO(StepForge): email.waitForEmail: IMAP inboxes are not exported; the helper reads a Mailpit server (MAILPIT_URL)
    Map<String, Object> email2 = Mail.waitForEmail(testStart, J.map("subject", "Welcome"), 20000);
