    browser.storage("local", "set", "cart", "{\"items\":2}");
    // Read the local storage "cart" (save as cart)
    Browser.Stored stored2 = browser.storage("local", "get", "cart", null);
    check(stored2.exists(), "equals", true, "exists equals");
    vars.put("cart", stored2.value());
    // Clear session storage
    browser.storage("session", "clear", null, null);
