// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Shop › Checkout › Checkout with every UI step (P1, #smoke #checkout flow)
// Covers the whole UI catalogue.
// Preconditions: A product is in stock.
package tests.shop.checkout;

import static support.Checks.capture;
import static support.Checks.check;
import static support.Checks.text;

import java.util.HashMap;
import java.util.Map;
import java.util.stream.Stream;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;
import org.junit.jupiter.params.provider.MethodSource;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import support.BrowserTest;
import support.Browser.Loc;
import support.Config;
import support.J;
import pages.LoginPage;
import pages.ProductsPage;

@Tag("smoke")
@Tag("checkout_flow")
@Tag("p1")
@DisplayName("Shop › Checkout › Checkout with every UI step")
class CheckoutWithEveryUiStepTest extends BrowserTest {
  static Stream<Arguments> testCases() {
    return Stream.of(
        Arguments.of("TC-CHE-001 Card payment", J.map("user", "ana@shop.test", "qty", 2)),
        Arguments.of("TC-CHE-002 Voucher \"SAVE10\"", J.map("user", "ben@shop.test", "qty", 1))
    );
  }

  @ParameterizedTest(name = "{0}")
  @MethodSource("testCases")
  void checkoutWithEveryUiStep(String testCase, Map<String, Object> data) throws Exception {
    Map<String, Object> vars = new HashMap<>();
    // Block: Sign in as admin
    // Open /login
    browser.goTo("/login");
    // Type "{{data.user}}" into the "Email" field
    browser.fill(LoginPage.EMAIL_FIELD, text(data.get("user")));
    // Type "{{secret.adminPassword}}" into the field with placeholder "Password"
    browser.fill(LoginPage.PASSWORD_FIELD, Config.secret("ADMIN_PASSWORD"));
    // Click the "Sign in" button
    browser.click(LoginPage.SIGN_IN_BUTTON);
    // Scenario: Open the cart
    // Open /cart
    browser.goTo("/cart");
    // Open {{env.baseUrl}}/products?region={{env.region}}
    browser.goTo(Config.baseUrl() + "/products?region=" + Config.env("region"));
    browser.expect("titleContains", null, "Products", null);
    // Click the element "product-1"
    browser.click(ProductsPage.PRODUCT1);
    browser.expect("urlMatches", null, "/products/\\d+", null);
    // Double-click "Zoom image"
    browser.doubleClick(ProductsPage.ZOOM_IMAGE_TEXT);
    // Right-click the element ".gallery img"
    browser.rightClick(ProductsPage.ELEMENT3);
    // Hover over the "Details" link
    browser.hover(ProductsPage.DETAILS_LINK);
    // Type "blue {{data.qty}}" into the "Search" field
    browser.type(ProductsPage.SEARCH_FIELD, "blue " + text(data.get("qty")));
    // Clear the "Search" field
    browser.clear(ProductsPage.SEARCH_FIELD);
    // Type "{{data.qty}}" into the element "qty"
    browser.fill(ProductsPage.QTY, text(data.get("qty")));
    browser.expect("value", ProductsPage.QTY, data.get("qty"), null);
    // Press Enter in the element "qty"
    browser.press(ProductsPage.QTY, "Enter");
    // Press Control+A
    browser.press(null, "Control+A");
    // Select "express" in the "Shipping" field
    browser.selectValue(ProductsPage.SHIPPING_FIELD, "express");
    // Select "Gift wrap" in the "Extras" field
    browser.selectLabel(ProductsPage.EXTRAS_FIELD, "Gift wrap");
    // Select "2" in the "Country" field
    browser.selectIndex(ProductsPage.COUNTRY_FIELD, 2);
    // Tick the "I agree" checkbox
    browser.setChecked(ProductsPage.I_AGREE_CHECKBOX, true);
    // Untick the "Newsletter" checkbox
    browser.setChecked(ProductsPage.NEWSLETTER_CHECKBOX, false);
    // Upload fixtures/invoice.pdf to the "Attachment" field
    browser.upload(ProductsPage.ATTACHMENT_FIELD, "fixtures/invoice.pdf");
    // Drag the element "item-a" onto the element "basket"
    browser.drag(ProductsPage.ITEM_A, ProductsPage.BASKET);
    // Scroll down the page
    browser.scroll(0, 800);
    // Scroll to the element "footer"
    browser.scrollIntoView(ProductsPage.FOOTER);
    // Accept the next browser dialog
    browser.handleNextDialog(true, "yes");
    // Click the element "//button[@id='remove']"
    browser.click(ProductsPage.ELEMENT16);
    // Dismiss the next browser dialog
    browser.handleNextDialog(false, null);
    // Switch into the frame "iframe#payment"
    browser.frame("iframe#payment");
    // Type "4242 4242 4242 4242" into the field with placeholder "Card number"
    browser.fill(Loc.of("placeholder", "Card number"), "4242 4242 4242 4242");
    // Return to the main page
    browser.frame(null);
    // Click the "Terms" link
    browser.click(ProductsPage.TERMS_LINK);
    // Switch to the new tab
    browser.switchTab(null, null);
    // Wait for the page to load
    browser.waitForLoad();
    // Close the current tab
    browser.closeTab();
    // Switch to the new tab
    browser.switchTab(0, null);
    // Wait until the element "spinner" is hidden
    browser.waitFor(Loc.of("testId", "spinner"), "hidden");
    // Wait for the URL **/checkout/*
    browser.waitForUrl("**/checkout/*");
    // Order summary
    browser.screenshot("orderSummary", null);
    // Total box
    browser.screenshot("totalBox", Loc.of("testId", "total"));
    // Read the text of the element "total" (save as total)
    vars.put("total", capture(browser.read("text", Loc.of("testId", "total"), null), "([\\d.]+)"));
    // Read the attribute of the "Invoice" link (save as invoiceUrl)
    vars.put("invoiceUrl", browser.read("attribute", Loc.of("role", "link", "Invoice"), "href"));
    // Read the count of the element ".line-item" (save as lines)
    vars.put("lines", browser.read("count", Loc.of("css", ".line-item"), null));
    // Read the url of the page (save as here)
    vars.put("here", browser.read("url", null, null));
    // Check that the "Order confirmed" heading is visible
    browser.expect("visible", Loc.of("role", "heading", "Order confirmed"), null, null);
    // Check that the element "error" is hidden
    browser.expect("hidden", Loc.of("testId", "error"), null, null);
    // Check that the element "greeting" reads "Thank you, {{data.user}}!"
    browser.expect("text", Loc.of("testId", "greeting"), "Thank you, " + text(data.get("user")) + "!", null);
    // Check that the element "total" contains "{{vars.total}}"
    browser.expect("textContains", Loc.of("testId", "total"), vars.get("total"), null);
    // Check that the element "order-id" matches /^ORD-\d{6}$/
    browser.expect("textMatches", Loc.of("testId", "order-id"), "^ORD-\\d{6}$", null);
    // Check that the "Shipping" field has the value "express"
    browser.expect("value", Loc.of("label", "Shipping"), "express", null);
    // Check that there are 2 × the element ".line-item"
    browser.expect("count", Loc.of("css", ".line-item"), 2, null);
    // Check an attribute of the element "cart" equals "false"
    browser.expect("attribute", Loc.of("testId", "cart"), "false", "aria-busy");
    // Check that the "Pay" button is enabled
    browser.expect("enabled", Loc.of("role", "button", "Pay"), null, null);
    // Check that the "Undo" button is disabled
    browser.expect("disabled", Loc.of("role", "button", "Undo"), null, null);
    // Check that the "I agree" checkbox is checked
    browser.expect("checked", Loc.of("role", "checkbox", "I agree"), null, null);
    // Check that the "Newsletter" checkbox is not checked
    browser.expect("unchecked", Loc.of("role", "checkbox", "Newsletter"), null, null);
    // Check that the URL is "/orders/done"
    browser.expect("url", null, "/orders/done", null);
    // Check that the URL contains "done"
    browser.expect("urlContains", null, "done", null);
    // Check that the page title is "Order confirmed"
    browser.expect("title", null, "Order confirmed", null);
    // Check that the page title contains "confirmed"
    browser.expect("titleContains", null, "confirmed", null);
    // Click the element "receipt"
    browser.click(Loc.of("testId", "receipt"));
    vars.put("actual1", browser.read("text", Loc.of("testId", "receipt"), null));
    check(vars.get("actual1"), "notContains", "Error", "text notContains");
    // TODO(StepForge): ui.visualCheckpoint: visual checkpoints are not exported; add a screenshot comparison in the target framework
    // Disabled in StepForge: Click the element "legacy"
  }
}
