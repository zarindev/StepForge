# Scenario: API › Orders API (P2, #api)
import time

import pytest

from support.config import env, secret
from support.helpers import check, compare, pick, fake, field, text, random_value, RUN_ID
from support import api


@pytest.mark.api
@pytest.mark.p2
def test_orders_api(http):
    """Orders API"""
    data = {}
    vars = {}
    # Get a token
    res1 = api.call(
        http, "POST", "/oauth/token",
        form={
            "client": "shop",
            "scope": "orders",
        },
    )
    assert res1["status"] == 200, "status"
    vars["token"] = res1["body"]
    # TODO(StepForge): api.request: the JSON Schema check on "$" is not exported
    res2 = api.call(
        http, "POST", f"/api/{text(env['api-version'])}/orders",
        headers={"X-Request-Id": text(random_value("uuid")), "X-Region": env["region"], "Authorization": f"Bearer {secret("API_TOKEN")}"},
        params={"dryRun": False},
        json={
            "items": [{
                "sku": "A-1",
                "qty": 2,
            }],
            "note": "it's \"quoted\" & {braced}",
            "email": random_value("email"),
            "at": random_value("timestamp"),
        },
    )
    assert res2["status"] == 201, "status"
    check(pick(res2, "$.id"), "exists", None, "$.id exists")
    check(pick(res2, "$.items[*].sku"), "contains", "A-1", "$.items[*].sku contains")
    check(pick(res2, "header:content-type"), "contains", "json", "header:content-type contains")
    check(pick(res2, "time"), "lte", 800, "time lte")
    check(pick(res2, "$.total"), "inRange", [0, 1000], "$.total inRange")
    vars["order"] = res2["body"]
    # Read the location header of the response (save as location)
    vars["location"] = pick(res2, "header:location")
    # Read the response status (save as code)
    vars["code"] = pick(res2, "status")
    # Basic auth
    res3 = api.call(
        http, "GET", "/admin",
        auth=("admin", secret("ADMIN_PASSWORD")), 
    )
    # API key in query
    res4 = api.call(
        http, "GET", "/reports",
        params={"key": secret("API_TOKEN")},
    )
    # API key header
    res5 = api.call(
        http, "DELETE", f"/api/orders/{text(field(vars, 'order.id'))}",
        headers={"x-api-key": secret("API_TOKEN")},
    )
    # Cookie
    res6 = api.call(
        http, "GET", "/me",
        headers={"Cookie": f"sid={"abc"}"},
    )
    # TODO(StepForge): api.request: auth type "oauth2" is not exported; set the header yourself
    res7 = api.call(
        http, "GET", "/x",
    )
    # Upload
    res8 = api.call(
        http, "POST", "/files",
        files={
            "name": "a.txt",
        },
    )
    # Raw text
    res9 = api.call(
        http, "PUT", "https://other.test/raw",
        data=f"plain {text(data.get('missing'))} text",
    )
    # GraphQL
    res10 = api.call(
        http, "POST", "/graphql",
        params={"0": "q", "1": "u", "2": "e", "3": "r", "4": "y", "5": " ", "6": "{", "7": " ", "8": "m", "9": "e", "10": " ", "11": "{", "12": " ", "13": "i", "14": "d", "15": " ", "16": "}", "17": " ", "18": "}"},
        json={
            "query": "query { me { id } }",
            "variables": {
                "first": 1,
            },
        },
    )
    check(pick(res10, "$.data.me.id"), "isNotEmpty", None, "$.data.me.id isNotEmpty")
    check(pick(res10, "$.errors"), "notExists", None, "$.errors notExists")
    # If {{vars.code}} equals "201"
    if compare(vars.get("code"), "equals", 201):
        # Note: Created {{vars.order.id}}
        print(f"Created {text(field(vars, 'order.id'))}")
    else:
        # Note: Not created
        print("Not created")
    # Repeat 3 times
    for index in range(3):
        vars["index"] = index
        # Send GET /ping?i={{vars.index}}
        res11 = api.call(
            http, "GET", f"/ping?i={text(vars.get('index'))}",
        )
    # Repeat for each line in {{vars.order.items}}
    for index, item in enumerate(field(vars, "order.items")):
        vars["line"] = item
        vars["index"] = index
        # Note: {{vars.line.sku}}
        print(field(vars, "line.sku"))
    # Remember "[object Object]" as payload
    vars["payload"] = {
        "a": [1, True, None],
        "b": RUN_ID,
    }
    # Generate a random pattern (save as ref)
    vars["ref"] = fake("pattern", pattern="ORD-####")
    # Generate a random date (save as due)
    vars["due"] = fake("date", direction="future", days=10)
    # Wait 250 ms
    time.sleep(0.25)
    # Run a script (save as double)
