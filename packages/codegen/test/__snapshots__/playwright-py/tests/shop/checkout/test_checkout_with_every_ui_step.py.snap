# Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
# Scenario: Shop › Checkout › Checkout with every UI step (P1, #smoke #checkout flow)
# Covers the whole UI catalogue.
# Preconditions: A product is in stock.
import re

import pytest
from playwright.sync_api import expect

from support.config import absolute, env, secret
from support.helpers import check, capture, text
from support.tabs import switch_tab


@pytest.mark.smoke
@pytest.mark.checkout_flow
@pytest.mark.p1
@pytest.mark.parametrize(
    "data",
    [{"user": "ana@shop.test", "qty": 2}, {"user": "ben@shop.test", "qty": 1}],
    ids=["TC-CHE-001 Card payment", "TC-CHE-002 Voucher \"SAVE10\""],
)
def test_checkout_with_every_ui_step(page, data):
    """Checkout with every UI step"""
    current = page
    vars = {}
    # Block: Sign in as admin
    # Open /login
    current.goto("/login")
    # Type "{{data.user}}" into the "Email" field
    current.get_by_label("Email", exact=True).fill(text(data.get("user")))
    # Type "{{secret.adminPassword}}" into the field with placeholder "Password"
    current.get_by_placeholder("Password", exact=True).fill(secret("ADMIN_PASSWORD"))
    # Click the "Sign in" button
    current.get_by_role("button", name="Sign in", exact=True).click()
    # Scenario: Open the cart
    # Open /cart
    current.goto("/cart")
    # Open {{env.baseUrl}}/products?region={{env.region}}
    current.goto(f"{text(env['base_url'])}/products?region={text(env['region'])}")
    expect(current).to_have_title(re.compile(re.escape("Products")))
    # Click the element "product-1"
    current.get_by_test_id("product-1").click()
    expect(current).to_have_url(re.compile("/products/\\d+"))
    # Double-click "Zoom image"
    current.get_by_text("Zoom image", exact=True).dblclick()
    # Right-click the element ".gallery img"
    current.locator(".gallery img").click(button="right")
    # Hover over the "Details" link
    current.get_by_role("link", name="Details", exact=True).hover()
    # Type "blue {{data.qty}}" into the "Search" field
    current.get_by_label("Search", exact=True).press_sequentially(f"blue {text(data.get('qty'))}")
    # Clear the "Search" field
    current.get_by_label("Search", exact=True).clear()
    # Type "{{data.qty}}" into the element "qty"
    current.get_by_test_id("qty").fill(text(data.get("qty")))
    expect(current.get_by_test_id("qty")).to_have_value(text(data.get("qty")))
    # Press Enter in the element "qty"
    current.get_by_test_id("qty").press("Enter")
    # Press Control+A
    current.keyboard.press("Control+A")
    # Select "express" in the "Shipping" field
    current.get_by_label("Shipping", exact=True).select_option(value="express")
    # Select "Gift wrap" in the "Extras" field
    current.get_by_label("Extras", exact=True).select_option(label="Gift wrap")
    # Select "2" in the "Country" field
    current.get_by_label("Country", exact=True).select_option(index=2)
    # Tick the "I agree" checkbox
    current.get_by_role("checkbox", name="I agree", exact=True).check()
    # Untick the "Newsletter" checkbox
    current.get_by_role("checkbox", name="Newsletter", exact=True).uncheck()
    # Upload fixtures/invoice.pdf to the "Attachment" field
    current.get_by_label("Attachment", exact=True).set_input_files(["fixtures/invoice.pdf"])
    # Drag the element "item-a" onto the element "basket"
    current.get_by_test_id("item-a").drag_to(current.get_by_test_id("basket"))
    # Scroll down the page
    current.mouse.wheel(0, 800)
    # Scroll to the element "footer"
    current.get_by_test_id("footer").scroll_into_view_if_needed()
    # Accept the next browser dialog
    current.once("dialog", lambda dialog: dialog.accept("yes"))
    # Click the element "//button[@id='remove']"
    current.locator("xpath=//button[@id='remove']").click()
    # Dismiss the next browser dialog
    current.once("dialog", lambda dialog: dialog.dismiss())
    # Switch into the frame "iframe#payment"
    frame1 = current.frame_locator("iframe#payment")
    # Type "4242 4242 4242 4242" into the field with placeholder "Card number"
    frame1.get_by_placeholder("Card number", exact=True).fill("4242 4242 4242 4242")
    # Return to the main page
    # Click the "Terms" link
    current.get_by_role("link", name="Terms", exact=True).click()
    # Switch to the new tab
    current = switch_tab(page.context)
    # Wait for the page to load
    current.wait_for_load_state("domcontentloaded")
    # Close the current tab
    current.close()
    current = page.context.pages[-1]
    # Switch to the new tab
    current = switch_tab(page.context, index=0)
    # Wait until the element "spinner" is hidden
    current.get_by_test_id("spinner").wait_for(state="hidden")
    # Wait for the URL **/checkout/*
    current.wait_for_url("**/checkout/*")
    # Order summary
    current.screenshot(path="screenshots/orderSummary.png", full_page=True)
    # Total box
    current.get_by_test_id("total").screenshot(path="screenshots/totalBox.png")
    # Read the text of the element "total" (save as total)
    vars["total"] = capture((current.get_by_test_id("total").text_content() or "").strip(), "([\\d.]+)")
    # Read the attribute of the "Invoice" link (save as invoiceUrl)
    vars["invoiceUrl"] = current.get_by_role("link", name="Invoice", exact=True).get_attribute("href")
    # Read the count of the element ".line-item" (save as lines)
    vars["lines"] = current.locator(".line-item").count()
    # Read the url of the page (save as here)
    vars["here"] = current.url
    # Check that the "Order confirmed" heading is visible
    expect(current.get_by_role("heading", name="Order confirmed", exact=True)).to_be_visible()
    # Check that the element "error" is hidden
    expect(current.get_by_test_id("error")).to_be_hidden()
    # Check that the element "greeting" reads "Thank you, {{data.user}}!"
    expect(current.get_by_test_id("greeting")).to_have_text(f"Thank you, {text(data.get('user'))}!")
    # Check that the element "total" contains "{{vars.total}}"
    expect(current.get_by_test_id("total")).to_contain_text(text(vars.get("total")))
    # Check that the element "order-id" matches /^ORD-\d{6}$/
    expect(current.get_by_test_id("order-id")).to_have_text(re.compile("^ORD-\\d{6}$"))
    # Check that the "Shipping" field has the value "express"
    expect(current.get_by_label("Shipping", exact=True)).to_have_value("express")
    # Check that there are 2 × the element ".line-item"
    expect(current.locator(".line-item")).to_have_count(2)
    # Check an attribute of the element "cart" equals "false"
    expect(current.get_by_test_id("cart")).to_have_attribute("aria-busy", "false")
    # Check that the "Pay" button is enabled
    expect(current.get_by_role("button", name="Pay", exact=True)).to_be_enabled()
    # Check that the "Undo" button is disabled
    expect(current.get_by_role("button", name="Undo", exact=True)).to_be_disabled()
    # Check that the "I agree" checkbox is checked
    expect(current.get_by_role("checkbox", name="I agree", exact=True)).to_be_checked()
    # Check that the "Newsletter" checkbox is not checked
    expect(current.get_by_role("checkbox", name="Newsletter", exact=True)).not_to_be_checked()
    # Check that the URL is "/orders/done"
    expect(current).to_have_url(absolute("/orders/done"))
    # Check that the URL contains "done"
    expect(current).to_have_url(re.compile(re.escape("done")))
    # Check that the page title is "Order confirmed"
    expect(current).to_have_title("Order confirmed")
    # Check that the page title contains "confirmed"
    expect(current).to_have_title(re.compile(re.escape("confirmed")))
    # Click the element "receipt"
    current.get_by_test_id("receipt").click()
    vars["actual1"] = (current.get_by_test_id("receipt").text_content() or "").strip()
    check(vars.get("actual1"), "notContains", "Error", "text notContains")
    # TODO(StepForge): ui.visualCheckpoint: visual checkpoints are not exported; add a screenshot comparison in the target framework
    # Disabled in StepForge: Click the element "legacy"
