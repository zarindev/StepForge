// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Shop › Checkout › Checkout with every UI step (P1, #smoke #checkout flow)
// Covers the whole UI catalogue.
// Preconditions: A product is in stock.
import { check, capture } from '../../../support/helpers.js';
import { env, secret } from '../../../support/config.js';
import { globToRegExp } from '../../../support/api.js';

// Tags: @smoke @checkout-flow @p1
describe('Shop › Checkout › Checkout with every UI step', () => {
  const testCases = [
    { code: 'TC-CHE-001', title: 'Card payment', data: { user: 'ana@shop.test', qty: 2 } },
    { code: 'TC-CHE-002', title: 'Voucher "SAVE10"', data: { user: 'ben@shop.test', qty: 1 } },
  ];

  testCases.forEach(({ code, title, data }) => {
    it(`${code} ${title}`, () => {
      const vars = {};
      const last = {};
      // Block: Sign in as admin
      // Open /login
      cy.visit('/login');
      // Type "{{data.user}}" into the "Email" field
      cy.findByLabelText('Email').fill(String(data.user));
      // Type "{{secret.adminPassword}}" into the field with placeholder "Password"
      cy.findByPlaceholderText('Password').fill(secret('ADMIN_PASSWORD'));
      // Click the "Sign in" button
      cy.findByRole('button', { name: 'Sign in' }).click();
      // Scenario: Open the cart
      // Open /cart
      cy.visit('/cart');
      // Open {{env.baseUrl}}/products?region={{env.region}}
      cy.visit(`${env.baseUrl}/products?region=${env.region}`);
      cy.title().should('include', 'Products');
      // Click the element "product-1"
      cy.findByTestId('product-1').click();
      cy.url().should('match', new RegExp('/products/\\d+'));
      // Double-click "Zoom image"
      cy.findByText('Zoom image').dblclick();
      // Right-click the element ".gallery img"
      cy.get('.gallery img').rightclick();
      // Hover over the "Details" link
      // Cypress has no real hover; this fires the mouseover event
      cy.findByRole('link', { name: 'Details' }).trigger('mouseover');
      // Type "blue {{data.qty}}" into the "Search" field
      cy.findByLabelText('Search').type(`blue ${data.qty}`, { parseSpecialCharSequences: false });
      // Clear the "Search" field
      cy.findByLabelText('Search').clear();
      // Type "{{data.qty}}" into the element "qty"
      cy.findByTestId('qty').fill(String(data.qty));
      cy.findByTestId('qty').should('have.value', String(data.qty));
      // Press Enter in the element "qty"
      cy.findByTestId('qty').type('{enter}');
      // Press Control+A
      cy.focused().type('{selectAll}');
      // Select "express" in the "Shipping" field
      cy.findByLabelText('Shipping').select('express');
      // Select "Gift wrap" in the "Extras" field
      cy.findByLabelText('Extras').select('Gift wrap');
      // Select "2" in the "Country" field
      cy.findByLabelText('Country').select(2);
      // Tick the "I agree" checkbox
      cy.findByRole('checkbox', { name: 'I agree' }).check();
      // Untick the "Newsletter" checkbox
      cy.findByRole('checkbox', { name: 'Newsletter' }).uncheck();
      // Upload fixtures/invoice.pdf to the "Attachment" field
      cy.findByLabelText('Attachment').selectFile(['fixtures/invoice.pdf']);
      // Drag the element "item-a" onto the element "basket"
      // TODO(StepForge): drag cy.findByTestId('item-a') onto cy.findByTestId('basket') (needs a Cypress drag-and-drop plugin)
      // Scroll down the page
      cy.scrollTo(0, 800);
      // Scroll to the element "footer"
      cy.findByTestId('footer').scrollIntoView();
      // Accept the next browser dialog
      cy.window().then((win) => cy.stub(win, 'prompt').returns('yes'));
      // Click the element "//button[@id='remove']"
      cy.xpath("//button[@id='remove']").click();
      // Dismiss the next browser dialog
      cy.on('window:confirm', () => false);
      // Switch into the frame "iframe#payment"
      // TODO(StepForge): switch into the iframe iframe#payment (needs cypress-iframe); the next steps run in the page
      // Type "4242 4242 4242 4242" into the field with placeholder "Card number"
      cy.findByPlaceholderText('Card number').fill('4242 4242 4242 4242');
      // Return to the main page
      // Click the "Terms" link
      cy.findByRole('link', { name: 'Terms' }).click();
      // Switch to the new tab
      // TODO(StepForge): switch tab — Cypress runs in a single tab
      // Wait for the page to load
      cy.document().its('readyState').should('eq', 'complete');
      // Close the current tab
      // TODO(StepForge): close tab — Cypress runs in a single tab
      // Switch to the new tab
      // TODO(StepForge): switch tab — Cypress runs in a single tab
      // Wait until the element "spinner" is hidden
      cy.findByTestId('spinner').should('not.be.visible');
      // Wait for the URL **/checkout/*
      cy.url().should('match', globToRegExp('**/checkout/*'));
      // Order summary
      cy.screenshot('orderSummary', { capture: 'fullPage' });
      // Total box
      cy.findByTestId('total').screenshot('totalBox');
      // Read the text of the element "total" (save as total)
      cy.then(() => {
        cy.findByTestId('total')
          .invoke('text')
          .then((value) => {
            vars.total = capture(String(value).trim(), '([\\d.]+)');
          });
      });
      // Read the attribute of the "Invoice" link (save as invoiceUrl)
      cy.then(() => {
        cy.findByRole('link', { name: 'Invoice' })
          .invoke('attr', 'href')
          .then((value) => {
            vars.invoiceUrl = value;
          });
      });
      // Read the count of the element ".line-item" (save as lines)
      cy.then(() => {
        cy.get('.line-item')
          .its('length')
          .then((value) => {
            vars.lines = value;
          });
      });
      // Read the url of the page (save as here)
      cy.then(() => {
        cy.url().then((value) => {
          vars.here = value;
        });
      });
      // Check that the "Order confirmed" heading is visible
      cy.findByRole('heading', { name: 'Order confirmed' }).should('be.visible');
      // Check that the element "error" is hidden
      cy.findByTestId('error').should('not.exist');
      // Check that the element "greeting" reads "Thank you, {{data.user}}!"
      cy.findByTestId('greeting').should(($el) =>
        expect($el.text().trim()).to.eq(`Thank you, ${data.user}!`),
      );
      // Check that the element "total" contains "{{vars.total}}"
      cy.then(() => {
        cy.findByTestId('total').should('contain.text', String(vars.total));
      });
      // Check that the element "order-id" matches /^ORD-\d{6}$/
      cy.findByTestId('order-id').should(($el) => expect($el.text()).to.match(new RegExp('^ORD-\\d{6}$')));
      // Check that the "Shipping" field has the value "express"
      cy.findByLabelText('Shipping').should('have.value', 'express');
      // Check that there are 2 × the element ".line-item"
      cy.get('.line-item').should('have.length', 2);
      // Check an attribute of the element "cart" equals "false"
      cy.findByTestId('cart').should('have.attr', 'aria-busy', 'false');
      // Check that the "Pay" button is enabled
      cy.findByRole('button', { name: 'Pay' }).should('be.enabled');
      // Check that the "Undo" button is disabled
      cy.findByRole('button', { name: 'Undo' }).should('be.disabled');
      // Check that the "I agree" checkbox is checked
      cy.findByRole('checkbox', { name: 'I agree' }).should('be.checked');
      // Check that the "Newsletter" checkbox is not checked
      cy.findByRole('checkbox', { name: 'Newsletter' }).should('not.be.checked');
      // Check that the URL is "/orders/done"
      cy.url().should('eq', new URL('/orders/done', Cypress.config('baseUrl')).href);
      // Check that the URL contains "done"
      cy.url().should('include', 'done');
      // Check that the page title is "Order confirmed"
      cy.title().should('eq', 'Order confirmed');
      // Check that the page title contains "confirmed"
      cy.title().should('include', 'confirmed');
      // Click the element "receipt"
      cy.findByTestId('receipt').click();
      cy.then(() => {
        cy.findByTestId('receipt')
          .invoke('text')
          .then((value) => {
            vars.actual1 = String(value).trim();
          });
      });
      cy.then(() => {
        check(vars.actual1, 'notContains', 'Error', 'text notContains');
      });
      // TODO(StepForge): ui.visualCheckpoint: visual checkpoints are not exported; add a screenshot comparison in the target framework
      // Disabled in StepForge: Click the element "legacy"
    });
  });
});
