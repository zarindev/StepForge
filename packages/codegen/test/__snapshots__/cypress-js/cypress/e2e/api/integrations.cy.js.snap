// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: API › Integrations (P2, #api)
import { check, runId } from '../../support/helpers.js';
import { env, secret } from '../../support/config.js';
import { toResult } from '../../support/api.js';
import { pickMessage } from '../../support/web.js';
import { xpathValue, expectNoFault } from '../../support/xml.js';

// Tags: @api @p2
describe('API › Integrations', () => {
  it('Integrations', () => {
    const vars = {};
    const last = {};
    const testStart = new Date().toISOString();
    // Get the price
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: '/soap/prices',
        headers: { 'content-type': 'text/xml; charset=utf-8', soapaction: '"urn:GetPrice"' },
        body: `<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header><auth:Token xmlns:auth="urn:auth">${secret('API_TOKEN')}</auth:Token></soap:Header>
  <soap:Body><m:GetPrice xmlns:m="urn:prices"><m:Sku>${vars.ref}</m:Sku></m:GetPrice></soap:Body>
</soap:Envelope>`,
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        expectNoFault(res.text);
        expect(res.status, 'status').to.eq(200);
        check(xpathValue(res.text, '//p:Price', { p: 'urn:prices' }), 'gt', 0, '//p:Price gt');
        check(xpathValue(res.text, 'count(//p:Line)', { p: 'urn:prices' }), 'gte', 1, 'count(//p:Line) gte');
        vars.price = res.body;
        last.api = res;
      });
    });
    // SOAP 1.2 envelope
    cy.then(() => {
      cy.request({
        method: 'POST',
        url: 'https://soap.example.test/ws',
        headers: { 'content-type': 'application/soap+xml; charset=utf-8; action="urn:Ping"' },
        body: '<?xml version="1.0"?>\n<env:Envelope xmlns:env="http://www.w3.org/2003/05/soap-envelope"><env:Body><Ping/></env:Body></env:Envelope>',
        failOnStatusCode: false,
      }).then((response) => {
        const res = toResult(response);
        check(
          xpathValue(res.text, 'xpath://*[local-name()="Pong"]'),
          'exists',
          null,
          'xpath://*[local-name()="Pong"] exists',
        );
        last.api = res;
      });
    });
    // Publish an order event
    cy.then(() => {
      cy.task(
        'kafka:produce',
        {
          options: {
            brokers: 'localhost:9092',
            topic: 'orders',
            key: vars.ref,
            value: {
              id: vars.ref,
              total: 10,
            },
            headers: {
              source: 'tests',
            },
            sasl: {
              mechanism: 'plain',
              username: 'shop',
              password: secret('API_TOKEN'),
            },
          },
          timeoutMs: 15000,
        },
        { timeout: 30000 },
      ).then((message) => {
        check(pickMessage(message, 'offset'), 'exists', null, 'offset exists');
      });
    });
    // Wait for the invoice event
    cy.then(() => {
      cy.task(
        'kafka:consume',
        {
          options: {
            brokers: 'localhost:9092',
            topic: 'invoices',
            path: '$.orderId',
            equals: vars.ref,
            timeoutMs: 20000,
          },
          since: testStart,
          timeoutMs: 20000,
        },
        { timeout: 35000 },
      ).then((message) => {
        check(pickMessage(message, '$.status'), 'equals', 'issued', '$.status equals');
        check(pickMessage(message, 'header:source'), 'equals', 'billing', 'header:source equals');
        vars.invoice = message;
      });
    });
    // Upload the price list
    cy.task(
      'ftp',
      {
        protocol: 'sftp',
        host: 'files.shop.test',
        port: 22,
        username: 'shop',
        password: secret('ADMIN_PASSWORD'),
        action: 'upload',
        remotePath: `/in/prices-${runId}.csv`,
        content: 'sku,price\nA-1,10\n',
      },
      { timeout: 60000 },
    );
    // Read the report
    cy.then(() => {
      cy.task(
        'ftp',
        {
          protocol: 'ftp',
          host: 'files.shop.test',
          username: 'shop',
          password: secret('ADMIN_PASSWORD'),
          action: 'download',
          remotePath: '/out/report.csv',
        },
        { timeout: 60000 },
      ).then((result) => {
        check(result.content, 'contains', 'A-1', 'content contains');
        vars.report = result;
      });
    });
    // List the inbox
    cy.task(
      'ftp',
      {
        protocol: 'ftps',
        host: 'files.shop.test',
        username: 'shop',
        password: secret('ADMIN_PASSWORD'),
        action: 'list',
        remotePath: '/in',
      },
      { timeout: 60000 },
    ).then((result) => {
      check(result.count, 'gte', 1, 'count gte');
    });
  });
});
