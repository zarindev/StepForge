// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Back office › Data and email (P3)
import { check, pick } from '../../support/helpers.js';
import { toResult } from '../../support/api.js';
import * as mail from '../../support/mail.js';

// Tags: @p3
describe('Back office › Data and email', () => {
  const testCases = [{ code: 'TC-BAC-001', title: 'Default', data: { email: 'qa@shop.test' } }];

  testCases.forEach(({ code, title, data }) => {
    it(`${code} ${title}`, () => {
      const vars = {};
      const last = {};
      const testStart = new Date().toISOString();
      // Order count
      // SQL also in sql/dataAndEmail/orderCount.sql
      cy.then(() => {
        cy.task('db:query', {
          connection: 'main',
          sql: `SELECT COUNT(*) AS n
FROM orders
WHERE email = $1`,
          params: [data.email],
        }).then((result) => {
          check(pick(result, 'value'), 'gte', 1, 'value gte');
          check(pick(result, 'column:n'), 'noNulls', null, 'column:n noNulls');
          check(pick(result, 'rows[0].n'), 'gt', 0, 'rows[0].n gt');
          vars.counts = result.rows;
          last.db = result;
        });
      });
      // Read value from the query result (save as n)
      cy.then(() => {
        vars.n = pick(last.db, 'value');
      });
      // Run a SQL script on local
      // SQL also in sql/dataAndEmail/script.sql
      cy.then(() => {
        cy.task('db:script', {
          connection: 'local',
          sql: `DELETE FROM carts;
VACUUM;`,
        }).then((result) => {
          last.db = result;
        });
      });
      // Call the procedure refresh_totals
      // SQL also in sql/dataAndEmail/procedure.sql
      cy.then(() => {
        cy.task('db:query', {
          connection: 'main',
          sql: 'CALL refresh_totals($1, $2)',
          params: [1, 'x'],
        }).then((result) => {
          last.db = result;
        });
      });
      // TODO(StepForge): db.query: SQL Server helpers are not generated; the SQL file is exported for reference
      // TODO(StepForge): db.mongoFind: MongoDB steps are not exported; use the MongoDB driver of the target language
      // TODO(StepForge): db.dataQualityCheck: the data-quality audit runs only in StepForge
      // Run the SQL query "SELECT ?" on unknown
      // SQL also in sql/dataAndEmail/query2.sql
      cy.then(() => {
        cy.task('db:query', { connection: 'unknown', sql: 'SELECT ?', params: [1] }).then((result) => {
          last.db = result;
        });
      });
      // Wait for an email to {{data.email}} with subject "Your order" (save as mail)
      cy.then(() => {
        cy.task(
          'mail:wait',
          { to: String(data.email), subject: 'Your order', since: testStart, timeoutMs: 15000 },
          { timeout: 20000 },
        ).then((email) => {
          vars.mail = email;
          last.email = email;
        });
      });
      // Check that the subject contains "order" and the body contains "Thank you" and it comes from shop@ and it has a link and it has the attachment "invoice"
      cy.then(() => {
        mail.assertEmail(last.email, {
          subjectContains: 'order',
          bodyContains: 'Thank you',
          from: 'shop@',
          hasLink: true,
          hasAttachment: 'invoice',
        });
      });
      // Read the one-time code from the email (save as otp)
      cy.then(() => {
        vars.otp = mail.otp(last.email);
      });
      // Read the "track" link from the email (save as trackUrl)
      cy.then(() => {
        vars.trackUrl = mail.link(last.email, { contains: 'track', index: 0 });
      });
      // Read "Order (\w+)" from the email (save as orderNo)
      cy.then(() => {
        vars.orderNo = mail.extract(last.email, 'Order (\\w+)');
      });
      // Open the "track" link in the email
      cy.then(() => {
        cy.request(mail.link(last.email, { contains: 'track' })).then((response) => {
          last.api = toResult(response);
        });
      });
      // TODO(StepForge): email.waitForEmail: IMAP inboxes are not exported; the helper reads a Mailpit server (MAILPIT_URL)
      cy.then(() => {
        cy.task(
          'mail:wait',
          { subject: 'Welcome', since: testStart, timeoutMs: 20000 },
          { timeout: 25000 },
        ).then((email) => {
          last.email = email;
        });
      });
      // TODO(StepForge): perf.pageMetrics: performance measurements run only in StepForge
      // TODO(StepForge): perf.lighthouse: performance measurements run only in StepForge
      // TODO(StepForge): perf.loadTest: load tests are not part of functional tests; export the scenario to k6 instead
      // TODO(StepForge): perf.queryPlan: performance measurements run only in StepForge
    });
  });
});
