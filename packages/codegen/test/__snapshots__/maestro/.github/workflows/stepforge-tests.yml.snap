# Generated by StepForge — by Md Zarin Tasnim
name: CareClinic mobile tests (Android)
on:
  push:
  workflow_dispatch:
jobs:
  tests:
    runs-on: ubuntu-latest
    env:
      BASE_URL: ${{ vars.BASE_URL || 'https://api.careclinic.test' }}
      APK: ${{ vars.APK || 'build/careclinic.apk' }}
      WARD: ${{ vars.WARD || 'North' }}
      NURSE_PASSWORD: ${{ secrets.NURSE_PASSWORD }}
    steps:
      - uses: actions/checkout@v4
      # Build or download the app here, and set APP (a repository variable) to its path.
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - run: curl -fsSL "https://get.maestro.mobile.dev" | bash && echo "$HOME/.maestro/bin" >> "$GITHUB_PATH"
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 35
          arch: x86_64
          target: google_apis
          emulator-options: -no-window -gpu swiftshader_indirect -noaudio -no-boot-anim -camera-back none
          disable-animations: true
          script: MAESTRO_NURSE_PASSWORD=$NURSE_PASSWORD MAESTRO_CLI_NO_ANALYTICS=1 maestro test --format junit --output results/junit.xml -e APP_ID=$APP_ID flows
