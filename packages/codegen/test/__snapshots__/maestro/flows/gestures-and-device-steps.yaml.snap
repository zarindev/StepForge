# Generated by StepForge — by Md Zarin Tasnim · CareClinic mobile · 2026-10-15
# Scenario: Gestures and device steps (P2)
appId: ${APP_ID}
name: "Gestures and device steps"
tags: ["p2"]
---
- launchApp:
    clearState: true
# Open careclinic://patients
- openLink: "careclinic://patients"
# TODO(StepForge): ui.navigate: phone and desktop apps have no pages to open; use a deep link (myapp://…) instead
# Scroll down until "support@careclinic.test" shows
- scrollUntilVisible:
    element: { text: ".*support@careclinic\\.test.*" }
    direction: DOWN
# Swipe up
- swipe:
    direction: UP
# Swipe left on the element "patient_list"
- swipe:
    from: { id: "patient_list" }
    direction: LEFT
# Drag "Ana Silva" onto another element
# TODO(StepForge): drag and drop is not exported to Maestro; use swipe with start and end points
# Long-press "Ana Silva"
- longPressOn: { text: ".*Ana Silva.*" }
# Double-click the element "avatar"
- doubleTapOn: { id: "avatar" }
# Hide the keyboard
- hideKeyboard:
    optional: true
# Go back
- hideKeyboard:
    optional: true
- back
# Turn the device to landscape
- setOrientation: LANDSCAPE_LEFT
# Put the app in the background for 2 s
# TODO(StepForge): Maestro cannot put the app in the background for a while; use stopApp and launchApp
# Close the app
- stopApp
# Open the app
- launchApp
# Reset the app’s data
- clearState
# Open the link careclinic://patients/42
- openLink: "careclinic://patients/42"
# Set the device location to 51.5072, -0.1276
- setLocation:
    latitude: 51.5072
    longitude: -0.1276
# Grant the camera permission
# TODO(StepForge): Maestro sets permissions when it launches the app: add `permissions:` to launchApp
# Send a notification "Reminder"
# TODO(StepForge): Maestro cannot send notifications
# Accept the next dialog
- tapOn: "(?i)(OK|Allow|Yes|Accept|Continue|Turn on)"
# Press "Not now" in the dialog
- tapOn: "Not now"
# Choose Patients > Clear List from the menu
# TODO(StepForge): menu bars are for desktop apps; Maestro tests phone apps
# Select "North" in the element "ward"
- tapOn: { id: "ward" }
- tapOn: "North"
# Wait until the element "spinner" is hidden
- extendedWaitUntil:
    notVisible: { id: "spinner" }
    timeout: 30000
# Patients list
- takeScreenshot: "screenshots/patientsList"
# TODO(StepForge): ui.click: its locators (CSS) do not exist in phone and desktop apps; add an id, text, label or XPath locator
# TODO(StepForge): ui.click: image locators (pictures) are not exported; add an id, text, label locator
# Click the element "#save"
# TODO(StepForge): no locator Maestro can use (an id, text, label or placeholder) for xpath=//*[@text="Save"]
# TODO(StepForge): ui.hover: this is a web-page step; phone and desktop apps have no equivalent
# TODO(StepForge): ui.switchTab: this is a web-page step; phone and desktop apps have no equivalent
# TODO(StepForge): ui.assert: phone and desktop apps have no URL or page title to check
# Repeat 2 times
- repeat:
    times: 2
    commands:
      # Swipe up
      - swipe:
          direction: UP
# Wait 500 ms
# TODO(StepForge): Maestro has no fixed wait (500 ms); wait for an element instead (extendedWaitUntil)
