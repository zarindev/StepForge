# Generated by StepForge — by Md Zarin Tasnim · the steps of "Sign in and add a patient", run by each test case's flow
appId: ${APP_ID}
---
- launchApp:
    clearState: true
# Type "nurse@careclinic.test" into the field with placeholder "Email"
- tapOn: { text: "Email" }
- eraseText
- inputText: "nurse@careclinic.test"
# Type "{{secret.nursePassword}}" into the element "password"
- tapOn: { id: "password" }
- eraseText
- inputText: "${MAESTRO_NURSE_PASSWORD}"
# Click the "Sign in" button
- tapOn: { text: "Sign in" }
# Check that the element "patient_count" reads "No patients yet"
- assertVisible: { id: "patient_count", text: "No patients yet" }
# Type "{{data.name}}" into the "Patient name" field
- tapOn: { text: "Patient name" }
- eraseText
- inputText: "${name}"
# Tap "Add patient"
- tapOn: { text: ".*Add patient.*" }
# Check that the element "patient_count" contains "1"
- assertVisible: { id: "patient_count", text: ".*1.*" }
# Read the text of "{{data.name}}" (save as added)
- copyTextFrom: { text: ".*${name}.*" }
- evalScript: ${output.added = maestro.copiedText.trim()}
# If {{vars.added}} equals "{{data.name}}"
- runFlow:
    when:
      true: ${String(output.added) == String(name)}
    commands:
      # Note: Added {{vars.added}} in {{env.ward}}
      - evalScript: ${console.log("Added " + output.added + " in " + WARD + "")}
# Tick the element "reminders"
- runFlow:
    when:
      visible: { id: "reminders", checked: false }
    commands:
      - tapOn: { id: "reminders" }
# Check that the element "reminders" is checked
- assertVisible: { id: "reminders", checked: true }
# Press Enter in the element "patient_name"
- tapOn: { id: "patient_name" }
- pressKey: Enter
# Send GET {{env.baseUrl}}/patients
# TODO(StepForge): api steps are not part of Maestro flows (they test the app's screens); export them to an Appium or API target
