// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Shop › Browser › Network, storage and clock (P2, #browser)
import { test, expect } from '@playwright/test';
import { env } from '../../../support/config';
import { check, pick, field } from '../../../support/helpers';
import { watchNetwork, mockRoute, download, fileText, storage, pageCondition } from '../../../support/web';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

test.describe('Shop › Browser › Network, storage and clock', () => {
  test.use({ hasTouch: true });

  test('Network, storage and clock', { tag: ['@browser', '@p2'] }, async ({ page }) => {
    const vars: Vars = {};
    const network = watchNetwork(page.context(), env.baseUrl);
    // Set the page clock to 2026-03-01T09:00:00Z (running)
    await page.clock.install({ time: new Date('2026-03-01T09:00:00Z') });
    // Answer requests to **/api/stock* with 200
    await mockRoute(page.context(), {
      url: '**/api/stock*',
      method: 'GET',
      action: 'fulfill',
      status: 200,
      body: {
        inStock: true,
        sku: `${env.region}-1`,
      },
    });
    // Make requests to /api/ads fail
    await mockRoute(page.context(), { url: '/api/ads', action: 'abort' });
    // Slow down requests to /api/slow by 500 ms
    await mockRoute(page.context(), { url: '/api/slow', action: 'delay', delayMs: 500, times: 2 });
    // Answer requests to /api/banner with 503
    await mockRoute(page.context(), {
      url: '/api/banner',
      action: 'fulfill',
      status: 503,
      body: 'down',
      contentType: 'text/plain',
    });
    // Open /products
    network.navigated();
    await page.goto('/products');
    // Wait for the GET response from /api/products (save as products)
    const response1 = await network.waitForResponse({
      url: '/api/products',
      method: 'GET',
      status: 200,
      timeoutMs: 15000,
    });
    check(pick(response1, '$.items[0].sku'), 'exists', null, '$.items[0].sku exists');
    check(pick(response1, 'header:content-type'), 'contains', 'json', 'header:content-type contains');
    check(pick(response1, 'url'), 'contains', '/api/products', 'url contains');
    vars.products = response1.body;
    // Stop faking **/api/stock*
    await mockRoute(page.context(), { url: '**/api/stock*', action: 'remove' });
    // Tap the "Menu" button
    await page.getByRole('button', { name: 'Menu', exact: true }).tap();
    // Download the file from the "Export CSV" link (save as csv)
    const file1 = await download(
      page,
      page.getByRole('link', { name: 'Export CSV', exact: true }),
      test.info().outputDir,
    );
    check(file1.fileName, 'matches', '\\.csv$', 'fileName matches');
    check(file1.size, 'gt', 0, 'size gt');
    check(fileText(file1), 'contains', 'sku', 'content contains');
    vars.csv = file1;
    // Set the cookie "consent" to "yes"
    await storage(page, { kind: 'cookie', action: 'set', name: 'consent', value: 'yes' });
    // Read the cookie "consent"
    const stored1 = await storage(page, { kind: 'cookie', action: 'get', name: 'consent' });
    check(stored1.value, 'equals', 'yes', 'value equals');
    // Remove the cookie "consent"
    await storage(page, { kind: 'cookie', action: 'remove', name: 'consent' });
    // Set the local storage "cart" to "[object Object]"
    await storage(page, { kind: 'local', action: 'set', name: 'cart', value: '{"items":2}' });
    // Read the local storage "cart" (save as cart)
    const stored2 = await storage(page, { kind: 'local', action: 'get', name: 'cart' });
    check(stored2.exists, 'equals', true, 'exists equals');
    vars.cart = stored2.value;
    // Clear session storage
    await storage(page, { kind: 'session', action: 'clear' });
    // Clear all cookies
    await storage(page, { kind: 'cookie', action: 'clear' });
    // Go offline
    await page.context().setOffline(true);
    // Check that "You are offline" is visible
    await expect(page.getByText('You are offline', { exact: true })).toBeVisible();
    // Go back online
    await page.context().setOffline(false);
    // Move the clock forward 300000 ms
    await page.clock.fastForward(300000);
    // Set the page clock to 1772355600000
    await page.clock.setFixedTime(new Date(1772355600000));
    // If the "Accept cookies" button is visible
    if (
      await pageCondition(
        page.getByRole('button', { name: 'Accept cookies', exact: true }),
        'visible',
        undefined,
        1000,
      )
    ) {
      // Click the "Accept cookies" button
      await page.getByRole('button', { name: 'Accept cookies', exact: true }).click();
    } else {
      // Note: No cookie banner
      console.log('No cookie banner');
    }
    // Load every page
    let pass1 = 0;
    for (; pass1 < 20; pass1++) {
      vars.index = pass1;
      if (!(await pageCondition(page.getByRole('button', { name: 'Load more', exact: true }), 'enabled')))
        break;
      // Click the "Load more" button
      await page.getByRole('button', { name: 'Load more', exact: true }).click();
    }
    if (pass1 >= 20) throw new Error('Stopped after the limit of 20 pass(es); the condition still held');
    // If there are 12 × the element ".product-card"
    if (await pageCondition(page.locator('.product-card'), 'count', 12)) {
      // Note: A full page
      console.log('A full page');
    }
    // If the element "status" contains "{{vars.csv.fileName}}"
    if (
      await pageCondition(page.getByTestId('status'), 'textContains', String(field(vars, 'csv.fileName')))
    ) {
      // Note: Status names the file
      console.log('Status names the file');
    }
    // Check the network traffic of this page (save as traffic)
    const traffic1 = await network.summary(page, 'lastNavigation');
    check(traffic1.requests, 'lte', 60, 'requests lte');
    check(traffic1.kb, 'lt', 2000, 'kb lt');
    check(traffic1.failed, 'equals', 0, 'failed equals');
    check(traffic1.thirdPartyHosts, 'lte', 3, 'thirdPartyHosts lte');
    check(traffic1.byType['script']?.requests ?? 0, 'lte', 20, 'requests:script lte');
    vars.traffic = traffic1;
  });
});
