// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: Shop › Checkout › Checkout with every UI step (P1, #smoke #checkout flow)
// Covers the whole UI catalogue.
// Preconditions: A product is in stock.
import { test, expect } from '@playwright/test';
import { env, secret } from '../../../support/config';
import { check, capture, containing } from '../../../support/helpers';
import { switchTab } from '../../../support/tabs';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

const testCases: { code: string; title: string; data: Vars }[] = [
  { code: 'TC-CHE-001', title: 'Card payment', data: { user: 'ana@shop.test', qty: 2 } },
  { code: 'TC-CHE-002', title: 'Voucher "SAVE10"', data: { user: 'ben@shop.test', qty: 1 } },
];

test.describe('Shop › Checkout › Checkout with every UI step', () => {
  for (const { code, title, data } of testCases) {
    test(`${code} ${title}`, { tag: ['@smoke', '@checkout-flow', '@p1'] }, async ({ page }) => {
      let current = page;
      const vars: Vars = {};
      // Block: Sign in as admin
      // Open /login
      await current.goto('/login');
      // Type "{{data.user}}" into the "Email" field
      await current.getByLabel('Email', { exact: true }).fill(String(data.user));
      // Type "{{secret.adminPassword}}" into the field with placeholder "Password"
      await current.getByPlaceholder('Password', { exact: true }).fill(secret('ADMIN_PASSWORD'));
      // Click the "Sign in" button
      await current.getByRole('button', { name: 'Sign in', exact: true }).click();
      // Scenario: Open the cart
      // Open /cart
      await current.goto('/cart');
      // Open {{env.baseUrl}}/products?region={{env.region}}
      await current.goto(`${env.baseUrl}/products?region=${env.region}`);
      await expect(current).toHaveTitle(containing('Products'));
      // Click the element "product-1"
      await current.getByTestId('product-1').click();
      await expect(current).toHaveURL(new RegExp('/products/\\d+'));
      // Double-click "Zoom image"
      await current.getByText('Zoom image', { exact: true }).dblclick();
      // Right-click the element ".gallery img"
      await current.locator('.gallery img').click({ button: 'right' });
      // Hover over the "Details" link
      await current.getByRole('link', { name: 'Details', exact: true }).hover();
      // Type "blue {{data.qty}}" into the "Search" field
      await current.getByLabel('Search', { exact: true }).pressSequentially(`blue ${data.qty}`);
      // Clear the "Search" field
      await current.getByLabel('Search', { exact: true }).clear();
      // Type "{{data.qty}}" into the element "qty"
      await current.getByTestId('qty').fill(String(data.qty));
      await expect(current.getByTestId('qty')).toHaveValue(String(data.qty));
      // Press Enter in the element "qty"
      await current.getByTestId('qty').press('Enter');
      // Press Control+A
      await current.keyboard.press('Control+A');
      // Select "express" in the "Shipping" field
      await current.getByLabel('Shipping', { exact: true }).selectOption('express');
      // Select "Gift wrap" in the "Extras" field
      await current.getByLabel('Extras', { exact: true }).selectOption({ label: 'Gift wrap' });
      // Select "2" in the "Country" field
      await current.getByLabel('Country', { exact: true }).selectOption({ index: 2 });
      // Tick the "I agree" checkbox
      await current.getByRole('checkbox', { name: 'I agree', exact: true }).check();
      // Untick the "Newsletter" checkbox
      await current.getByRole('checkbox', { name: 'Newsletter', exact: true }).uncheck();
      // Upload fixtures/invoice.pdf to the "Attachment" field
      await current.getByLabel('Attachment', { exact: true }).setInputFiles(['fixtures/invoice.pdf']);
      // Drag the element "item-a" onto the element "basket"
      await current.getByTestId('item-a').dragTo(current.getByTestId('basket'));
      // Scroll down the page
      await current.mouse.wheel(0, 800);
      // Scroll to the element "footer"
      await current.getByTestId('footer').scrollIntoViewIfNeeded();
      // Accept the next browser dialog
      current.once('dialog', (dialog) => dialog.accept('yes'));
      // Click the element "//button[@id='remove']"
      await current.locator("xpath=//button[@id='remove']").click();
      // Dismiss the next browser dialog
      current.once('dialog', (dialog) => dialog.dismiss());
      // Switch into the frame "iframe#payment"
      const frame1 = current.frameLocator('iframe#payment');
      // Type "4242 4242 4242 4242" into the field with placeholder "Card number"
      await frame1.getByPlaceholder('Card number', { exact: true }).fill('4242 4242 4242 4242');
      // Return to the main page
      // Click the "Terms" link
      await current.getByRole('link', { name: 'Terms', exact: true }).click();
      // Switch to the new tab
      current = await switchTab(page.context());
      // Wait for the page to load
      await current.waitForLoadState('domcontentloaded');
      // Close the current tab
      await current.close();
      current = page.context().pages().at(-1)!;
      // Switch to the new tab
      current = await switchTab(page.context(), { index: 0 });
      // Wait until the element "spinner" is hidden
      await current.getByTestId('spinner').waitFor({ state: 'hidden' });
      // Wait for the URL **/checkout/*
      await current.waitForURL('**/checkout/*');
      // Order summary
      await current.screenshot({ path: test.info().outputPath('orderSummary.png'), fullPage: true });
      // Total box
      await current.getByTestId('total').screenshot({ path: test.info().outputPath('totalBox.png') });
      // Read the text of the element "total" (save as total)
      vars.total = capture(((await current.getByTestId('total').textContent()) ?? '').trim(), '([\\d.]+)');
      // Read the attribute of the "Invoice" link (save as invoiceUrl)
      vars.invoiceUrl = await current
        .getByRole('link', { name: 'Invoice', exact: true })
        .getAttribute('href');
      // Read the count of the element ".line-item" (save as lines)
      vars.lines = await current.locator('.line-item').count();
      // Read the url of the page (save as here)
      vars.here = current.url();
      // Check that the "Order confirmed" heading is visible
      await expect(current.getByRole('heading', { name: 'Order confirmed', exact: true })).toBeVisible();
      // Check that the element "error" is hidden
      await expect(current.getByTestId('error')).toBeHidden();
      // Check that the element "greeting" reads "Thank you, {{data.user}}!"
      await expect(current.getByTestId('greeting')).toHaveText(`Thank you, ${data.user}!`);
      // Check that the element "total" contains "{{vars.total}}"
      await expect(current.getByTestId('total')).toContainText(String(vars.total));
      // Check that the element "order-id" matches /^ORD-\d{6}$/
      await expect(current.getByTestId('order-id')).toHaveText(new RegExp('^ORD-\\d{6}$'));
      // Check that the "Shipping" field has the value "express"
      await expect(current.getByLabel('Shipping', { exact: true })).toHaveValue('express');
      // Check that there are 2 × the element ".line-item"
      await expect(current.locator('.line-item')).toHaveCount(2);
      // Check an attribute of the element "cart" equals "false"
      await expect(current.getByTestId('cart')).toHaveAttribute('aria-busy', 'false');
      // Check that the "Pay" button is enabled
      await expect(current.getByRole('button', { name: 'Pay', exact: true })).toBeEnabled();
      // Check that the "Undo" button is disabled
      await expect(current.getByRole('button', { name: 'Undo', exact: true })).toBeDisabled();
      // Check that the "I agree" checkbox is checked
      await expect(current.getByRole('checkbox', { name: 'I agree', exact: true })).toBeChecked();
      // Check that the "Newsletter" checkbox is not checked
      await expect(current.getByRole('checkbox', { name: 'Newsletter', exact: true })).not.toBeChecked();
      // Check that the URL is "/orders/done"
      await expect(current).toHaveURL('/orders/done');
      // Check that the URL contains "done"
      await expect(current).toHaveURL(containing('done'));
      // Check that the page title is "Order confirmed"
      await expect(current).toHaveTitle('Order confirmed');
      // Check that the page title contains "confirmed"
      await expect.soft(current).toHaveTitle(containing('confirmed'));
      // Click the element "receipt"
      await current.getByTestId('receipt').click();
      vars.actual1 = ((await current.getByTestId('receipt').textContent()) ?? '').trim();
      check(vars.actual1, 'notContains', 'Error', 'text notContains');
      // TODO(StepForge): ui.visualCheckpoint: visual checkpoints are not exported; add a screenshot comparison in the target framework
      // Disabled in StepForge: Click the element "legacy"
    });
  }
});
