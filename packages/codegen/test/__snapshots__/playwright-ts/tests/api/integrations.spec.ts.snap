// Generated by StepForge — by Md Zarin Tasnim · Shop Desk · 2026-10-07
// Scenario: API › Integrations (P2, #api)
import { test, expect } from '@playwright/test';
import { env, secret } from '../../support/config';
import { check, runId } from '../../support/helpers';
import { api } from '../../support/api';
import { xpathValue, expectNoFault } from '../../support/xml';
import * as kafka from '../../support/kafka';
import { pickMessage } from '../../support/kafka';
import { ftp } from '../../support/ftp';

type Vars = Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any

test.describe('API › Integrations', () => {
  test('Integrations', { tag: ['@api', '@p2'] }, async ({ request }) => {
    const testStart = new Date();
    const vars: Vars = {};
    // Get the price
    const res1 = await api(request, {
      method: 'POST',
      url: '/soap/prices',
      headers: { 'content-type': 'text/xml; charset=utf-8', soapaction: '"urn:GetPrice"' },
      data: `<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header><auth:Token xmlns:auth="urn:auth">${secret('API_TOKEN')}</auth:Token></soap:Header>
  <soap:Body><m:GetPrice xmlns:m="urn:prices"><m:Sku>${vars.ref}</m:Sku></m:GetPrice></soap:Body>
</soap:Envelope>`,
    });
    expectNoFault(res1.text);
    expect(res1.status, 'status').toBe(200);
    check(xpathValue(res1.text, '//p:Price', { p: 'urn:prices' }), 'gt', 0, '//p:Price gt');
    check(xpathValue(res1.text, 'count(//p:Line)', { p: 'urn:prices' }), 'gte', 1, 'count(//p:Line) gte');
    vars.price = res1.body;
    // SOAP 1.2 envelope
    const res2 = await api(request, {
      method: 'POST',
      url: 'https://soap.example.test/ws',
      headers: { 'content-type': 'application/soap+xml; charset=utf-8; action="urn:Ping"' },
      data: '<?xml version="1.0"?>\n<env:Envelope xmlns:env="http://www.w3.org/2003/05/soap-envelope"><env:Body><Ping/></env:Body></env:Envelope>',
    });
    check(
      xpathValue(res2.text, 'xpath://*[local-name()="Pong"]'),
      'exists',
      null,
      'xpath://*[local-name()="Pong"] exists',
    );
    // Publish an order event
    const message1 = await kafka.produce(
      {
        brokers: 'localhost:9092',
        topic: 'orders',
        key: vars.ref,
        value: {
          id: vars.ref,
          total: 10,
        },
        headers: {
          source: 'tests',
        },
        sasl: {
          mechanism: 'plain',
          username: 'shop',
          password: secret('API_TOKEN'),
        },
      },
      15000,
    );
    check(pickMessage(message1, 'offset'), 'exists', null, 'offset exists');
    // Wait for the invoice event
    const message2 = await kafka.consume(
      {
        brokers: 'localhost:9092',
        topic: 'invoices',
        path: '$.orderId',
        equals: vars.ref,
        timeoutMs: 20000,
      },
      testStart,
      20000,
    );
    check(pickMessage(message2, '$.status'), 'equals', 'issued', '$.status equals');
    check(pickMessage(message2, 'header:source'), 'equals', 'billing', 'header:source equals');
    vars.invoice = message2;
    // Upload the price list
    await ftp({
      protocol: 'sftp',
      host: 'files.shop.test',
      port: 22,
      username: 'shop',
      password: secret('ADMIN_PASSWORD'),
      action: 'upload',
      remotePath: `/in/prices-${runId}.csv`,
      content: 'sku,price\nA-1,10\n',
    });
    // Read the report
    const ftp2 = await ftp({
      protocol: 'ftp',
      host: 'files.shop.test',
      username: 'shop',
      password: secret('ADMIN_PASSWORD'),
      action: 'download',
      remotePath: '/out/report.csv',
    });
    check(ftp2.content, 'contains', 'A-1', 'content contains');
    vars.report = ftp2;
    // List the inbox
    const ftp3 = await ftp({
      protocol: 'ftps',
      host: 'files.shop.test',
      username: 'shop',
      password: secret('ADMIN_PASSWORD'),
      action: 'list',
      remotePath: '/in',
    });
    check(ftp3.count, 'gte', 1, 'count gte');
  });
});
