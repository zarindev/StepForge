# StepForge configuration. Copy to .env to override defaults. Everything is optional.

# Port for the local dashboard + API (always bound to 127.0.0.1).
STEPFORGE_PORT=4400

# Where StepForge keeps its SQLite database, artifacts and master key.
STEPFORGE_DATA_DIR=./data

# Log level: fatal | error | warn | info | debug | trace
STEPFORGE_LOG_LEVEL=info

# Open the dashboard in your default browser on start (1/0).
STEPFORGE_OPEN_BROWSER=1

# StepForge's local Mailpit (email testing): web/API port and SMTP port.
# STEPFORGE_MAILPIT_PORT=8025
# STEPFORGE_MAILPIT_SMTP_PORT=1025

# Downloaded tools (Mailpit, k6).
# STEPFORGE_BIN_DIR=./data/bin

# 1 = load the demo workspace on start (same as `npm start -- --demo`). Sample data only when asked for.
# STEPFORGE_DEMO=1
