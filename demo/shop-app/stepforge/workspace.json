      "name": "Products match the documented schema",
      "priority": "P2",
      "status": "ready",
      "tags": [
        "api",
        "regression"
      ],
      "testCases": [],
      "steps": [
        {
          "type": "util.useBlock",
          "label": "API login",
          "params": {
            "blockId": "b-api-admin"
          }
        },
        {
          "type": "api.request",
          "label": "List products",
          "params": {
            "method": "GET",
            "url": "/api/products",
            "auth": {
              "type": "bearer",
              "token": "{{vars.admin.token}}"
            }
          },
          "assertions": [
            {
              "target": "status",
              "operator": "equals",
              "expected": 200
            },
            {
              "target": "body",
              "operator": "matchesSchema",
              "expected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "sku",
                    "name",
                    "price",
                    "cost",
                    "stock"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "sku": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "price": {
                      "type": "number"
                    },
                    "cost": {
                      "type": "number"
                    },
                    "stock": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
