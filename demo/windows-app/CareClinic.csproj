<Project Sdk="Microsoft.NET.Sdk">
  <!-- CareClinic for Windows: a small WinForms app for StepForge's Windows tests. Build: dotnet build -c Release -o build -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>CareClinic</AssemblyName>
    <RootNamespace>CareClinic</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
